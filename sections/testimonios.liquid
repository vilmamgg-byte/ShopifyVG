          </blockquote>
          <div class="tm-card-footer">
            <div class="tm-card-sep"></div>
            <div class="tm-card-author">
              <div class="tm-avatar" aria-hidden="true">L</div>
              <div class="tm-card-id">
                <p class="tm-card-name">Laura P.</p>
                <p class="tm-card-profile">Estudiante de posgrado · 29 años</p>
              </div>
