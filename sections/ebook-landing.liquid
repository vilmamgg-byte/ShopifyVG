<script>
(function(){
  var book = document.querySelector('.el-book[data-page-1]');
  if (!book) return;
  var img = book.querySelector('.el-book-img');
  if (!img) return;
  var hint = book.querySelector('.el-book-flip-hint');
  var flipped = false, busy = false;

  var pW = book.offsetWidth;
  var pH = book.offsetHeight;

  var natW = 0, natH = 0;
  var preload = new Image();
  preload.onload = function(){ natW = this.naturalWidth; natH = this.naturalHeight; };
  preload.src = book.getAttribute('data-page-2');

  book.style.cursor = 'pointer';

  function isMobile(){ return window.innerWidth <= 768; }

  function doFlip(){
    if (busy) return;
    busy = true;
    var toPage2 = !flipped;
    var nextSrc = toPage2 ? book.getAttribute('data-page-2') : book.getAttribute('data-page-1');

    if (isMobile()) {
      /* ── Mobile: slide derecha→izquierda + recuadro horizontal ── */
      var outDir = toPage2 ? '-115%' : '115%';
      var inDir  = toPage2 ? '115%'  : '-115%';

      /* 1. Sale la imagen actual en la dirección correcta */
      img.style.transition = 'transform 0.36s ease-in, opacity 0.28s ease-in';
      img.style.transform  = 'translateX(' + outDir + ')';
      img.style.opacity    = '0';

      setTimeout(function(){
        /* 2. Cambia imagen y redimensiona el recuadro a horizontal */
        img.src = nextSrc;

        if (toPage2 && natW > 0 && natH > 0 && natW > natH) {
          /* imagen horizontal: ajusta el recuadro al ancho disponible */
          var maxW = Math.min(window.innerWidth - 48, 360);
          var tH   = Math.round(maxW / (natW / natH));
          book.style.width        = maxW + 'px';
          book.style.height       = tH   + 'px';
          book.style.borderRadius = '8px';
        } else if (!toPage2) {
          /* vuelve al recuadro vertical original */
          book.style.width        = pW + 'px';
          book.style.height       = pH + 'px';
          book.style.borderRadius = '';
        }

        /* 3. Posiciona la nueva imagen fuera de pantalla al lado contrario */
        img.style.transition = 'none';
        img.style.transform  = 'translateX(' + inDir + ')';
        img.style.opacity    = '0';

        requestAnimationFrame(function(){
          requestAnimationFrame(function(){
            /* 4. Desliza hacia el centro */
            img.style.transition = 'transform 0.36s ease-out, opacity 0.28s ease-out';
            img.style.transform  = '';
            img.style.opacity    = '';
            flipped = toPage2;
            book.classList.toggle('flipped', flipped);
            if (hint) hint.style.opacity = flipped ? '0' : '';
            setTimeout(function(){ busy = false; }, 380);
          });
        });
      }, 370);

    } else {
      /* ── Desktop: comprimir y expandir (page-flip) + redimensionar ── */
      img.style.transition = 'transform 0.32s ease, opacity 0.32s ease';
      img.style.transform  = 'scaleX(0)';
      img.style.opacity    = '0.15';

      setTimeout(function(){
        img.src = nextSrc;

        if (toPage2 && natW > 0 && natH > 0) {
          var ratio = natW / natH;
          var tW, tH;
          if (ratio > 1.1) {
            tW = Math.min(Math.round(pH * ratio), 560);
            tH = Math.round(tW / ratio);
          } else {
            tW = pW; tH = pH;
          }
          tW = Math.round(tW * 0.95);
          tH = Math.round(tH * 0.95);
          book.style.width        = tW + 'px';
          book.style.height       = tH + 'px';
          book.style.borderRadius = ratio > 1.1 ? '8px' : '';
        } else if (!toPage2) {
          book.style.width        = pW + 'px';
          book.style.height       = pH + 'px';
          book.style.borderRadius = '';
        }

        requestAnimationFrame(function(){
          requestAnimationFrame(function(){
            img.style.transform = '';
            img.style.opacity   = '';
            flipped = toPage2;
            book.classList.toggle('flipped', flipped);
            if (hint) hint.style.opacity = flipped ? '0' : '';
            setTimeout(function(){ busy = false; }, 420);
          });
        });
      }, 320);
    }
  }

  /* Swipe táctil en mobile */
  var txStart = 0, swiped = false;
  book.addEventListener('touchstart', function(e){
    txStart = e.touches[0].clientX;
    swiped  = false;
  }, { passive: true });

  book.addEventListener('touchend', function(e){
    var delta = txStart - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 40) {
      swiped = true;
      if (delta > 0 && !flipped) doFlip();     /* swipe izquierda → siguiente */
      else if (delta < 0 && flipped) doFlip(); /* swipe derecha   → anterior  */
      e.preventDefault(); /* evita que dispare también el click */
    }
  }, { passive: false });

  /* Clic / tap — omite si ya fue swipe */
  book.addEventListener('click', function(){
    if (swiped){ swiped = false; return; }
    doFlip();
  });
})();
</script>

<script>
(function(){
  var SELECTORS = [
    '.el-hero',
    '.el-cambio-wrap',
    '.el-emocion-wrap',
    '.el-section.el-section-alt',
    '#el-cierre'
  ];

  /* ── timing ─────────────────────────────────────────────────── */
  var DUR = 850;
  /* opacity: suave y lineal — fade cinematográfico sin aceleración brusca */
  /* transform: easeOutExpo — entra rápido y frena con elegancia al centro */
  var TRANS = 'opacity ' + DUR + 'ms ease, transform ' + (DUR + 80) + 'ms cubic-bezier(0.22,1,0.36,1)';

  /* distancias de desplazamiento (pequeñas = sutil, no slide agresivo) */
  var IN_OFFSET  = 26;  /* px — la sección entrante viene desde aquí       */
  var OUT_OFFSET = 18;  /* px — la sección saliente se aleja hasta aquí    */
  var SCALE_OFF  = 0.97; /* escala de secciones inactivas — sensación 3D leve */

  var slides = [];
  SELECTORS.forEach(function(sel){
    var el = document.querySelector(sel);
    if (el) slides.push(el);
  });
  if (slides.length < 2) return;

  var current = 0;
  var busy    = false;

  /* ── estado de cada slide ────────────────────────────────────── */
  function applyState(el, active, above){
    el.style.transition    = 'none';
    el.style.position      = 'fixed';
    el.style.top           = '0';
    el.style.left          = '0';
    el.style.width         = '100vw';
    el.style.height        = '100vh';
    if (active) {
      el.style.opacity       = '1';
      el.style.transform     = 'translateY(0) scale(1)';
      el.style.zIndex        = '10';
      el.style.pointerEvents = 'auto';
    } else {
      var ty = above ? (-IN_OFFSET) : IN_OFFSET;
      el.style.opacity       = '0';
      el.style.transform     = 'translateY(' + ty + 'px) scale(' + SCALE_OFF + ')';
      el.style.zIndex        = '5';
      el.style.pointerEvents = 'none';
    }
  }

  function initSlides(){
    slides.forEach(function(el, i){
      applyState(el, i === 0, false);
    });
    activateAnims(slides[0]);
  }

  function activateAnims(slide){
    slide.querySelectorAll('.el-anim').forEach(function(el){
      el.classList.add('visible');
    });
  }

  /* ── navegación ──────────────────────────────────────────────── */
  function goTo(next){
    if (busy || next === current || next < 0 || next >= slides.length) return;
    busy = true;

    var dir = next > current ? 1 : -1;   /* 1 = hacia abajo, -1 = hacia arriba */
    var cur = slides[current];
    var nxt = slides[next];

    /* posición de partida de la sección entrante */
    nxt.style.transition    = 'none';
    nxt.style.opacity       = '0';
    nxt.style.transform     = 'translateY(' + (dir * IN_OFFSET) + 'px) scale(' + SCALE_OFF + ')';
    nxt.style.zIndex        = '11';      /* encima durante la transición */
    nxt.style.pointerEvents = 'none';
    cur.style.zIndex        = '10';

    void nxt.offsetWidth;               /* fuerza reflow antes de animar */

    /* entrante: aparece y sube al centro */
    nxt.style.transition    = TRANS;
    nxt.style.opacity       = '1';
    nxt.style.transform     = 'translateY(0) scale(1)';

    /* saliente: se desvanece y retrocede levemente */
    cur.style.transition    = TRANS;
    cur.style.opacity       = '0';
    cur.style.transform     = 'translateY(' + (-dir * OUT_OFFSET) + 'px) scale(' + SCALE_OFF + ')';

    setTimeout(function(){
      slides.forEach(function(el, i){
        applyState(el, i === next, i < next);
      });
      current = next;
      updateDots();
      activateAnims(slides[current]);
      busy = false;
    }, DUR + 120);
  }

  /* ── navigation dots ─────────────────────────────────────────── */
  var nav = document.createElement('nav');
  nav.className = 'fp-nav';
  nav.setAttribute('aria-label', 'Navegación');
  slides.forEach(function(_, i){
    var btn = document.createElement('button');
    btn.className = 'fp-dot' + (i === 0 ? ' fp-dot--active' : '');
    btn.setAttribute('aria-label', 'Sección ' + (i + 1));
    btn.addEventListener('click', function(){ goTo(i); });
    nav.appendChild(btn);
  });
  document.body.appendChild(nav);

  /* ── anchor nav links (#el-inicio) ──────────────────────────── */
  document.querySelectorAll('a[href="#el-inicio"]').forEach(function(link){
    link.addEventListener('click', function(e){
      e.preventDefault();
      goTo(0);
    });
  });

  function updateDots(){
    nav.querySelectorAll('.fp-dot').forEach(function(btn, i){
      btn.classList.toggle('fp-dot--active', i === current);
    });
  }

  /* ── wheel — respeta scroll interno ─────────────────────────── */
  window.addEventListener('wheel', function(e){
    if (busy){ e.preventDefault(); return; }

    var inner = slides[current].querySelector('.el-container');
    var oy = inner ? window.getComputedStyle(inner).overflowY : '';
    if (inner && (oy === 'auto' || oy === 'scroll') && inner.scrollHeight > inner.clientHeight + 4){
      var atTop    = inner.scrollTop <= 0;
      var atBottom = inner.scrollTop + inner.clientHeight >= inner.scrollHeight - 2;
      if (e.deltaY > 3 && !atBottom) return;
      if (e.deltaY < -3 && !atTop)   return;
    }

    e.preventDefault();
    if (e.deltaY > 3)  goTo(current + 1);
    if (e.deltaY < -3) goTo(current - 1);
  }, { passive: false });

  /* ── touch ───────────────────────────────────────────────────── */
  var ty = 0;
  window.addEventListener('touchstart', function(e){
    ty = e.touches[0].clientY;
  }, { passive: true });
  window.addEventListener('touchend', function(e){
    if (busy) return;
    var dy = ty - e.changedTouches[0].clientY;
    if (dy > 40)  goTo(current + 1);
    if (dy < -40) goTo(current - 1);
  }, { passive: true });

  /* ── keyboard ────────────────────────────────────────────────── */
  window.addEventListener('keydown', function(e){
    if (busy) return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown'){ e.preventDefault(); goTo(current + 1); }
    if (e.key === 'ArrowUp'   || e.key === 'PageUp')  { e.preventDefault(); goTo(current - 1); }
  });

  initSlides();
})();
</script>

