          <line x1="31" y1="21.7" x2="45.5" y2="23.2" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.38"/>
          <line x1="31" y1="25.4" x2="45.5" y2="26.9" stroke="#c9a84c" stroke-width="0.95" stroke-linecap="round" opacity="0.30"/>
          <line x1="31" y1="29.2" x2="41"   y2="30.5" stroke="#c9a84c" stroke-width="0.9"  stroke-linecap="round" opacity="0.22"/>

