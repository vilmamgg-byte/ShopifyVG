  </div>

  <!-- ══════════════════════════════════════
       HEADER
  ══════════════════════════════════════ -->
  <header class="el-header" id="el-header">
    <a href="/" class="el-logo">
      <div class="el-logo-mark">
        <svg width="30" height="30" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="lgoldH" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%"   stop-color="#c9a84c"/>
              <stop offset="50%"  stop-color="#f0d878"/>
              <stop offset="100%" stop-color="#c9a84c"/>
            </linearGradient>
            <linearGradient id="lgoldV" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%"   stop-color="#f5e090"/>
              <stop offset="45%"  stop-color="#c9a84c"/>
              <stop offset="100%" stop-color="#8a6820"/>
            </linearGradient>
            <linearGradient id="lpageL" x1="100%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%"   stop-color="#c9a84c" stop-opacity="0.20"/>
              <stop offset="100%" stop-color="#c9a84c" stop-opacity="0.05"/>
            </linearGradient>
            <linearGradient id="lpageR" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%"   stop-color="#c9a84c" stop-opacity="0.11"/>
              <stop offset="100%" stop-color="#c9a84c" stop-opacity="0.03"/>
            </linearGradient>
            <radialGradient id="laura" cx="50%" cy="55%" r="50%">
              <stop offset="0%"   stop-color="#c9a84c" stop-opacity="0.10"/>
              <stop offset="100%" stop-color="#c9a84c" stop-opacity="0"/>
            </radialGradient>
            <filter id="lglow" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="1.2" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="lglowS" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="2" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>

          <!-- Aura de fondo -->
          <ellipse cx="28" cy="33" rx="22" ry="19" fill="url(#laura)"/>

          <!-- Sombra página izquierda -->
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z"
                fill="rgba(0,0,0,0.25)" transform="translate(1,1.5)"/>

          <!-- Página izquierda -->
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z"
                fill="url(#lpageL)"
                stroke="#c9a84c" stroke-width="1.05" stroke-linejoin="round"/>

          <!-- Brillo interior izquierda -->
          <path d="M25.5 13 L9.5 17 L9.5 42 L25.5 38 Z"
                fill="rgba(255,255,255,0.022)"/>

          <!-- Página derecha -->
          <path d="M29 11 L49 15.5 L49 44 L29 39.5 Z"
                fill="url(#lpageR)"
                stroke="#c9a84c" stroke-width="0.8" stroke-linejoin="round"/>

          <!-- Grosor inferior izquierda -->
          <path d="M7 44 L9.5 45.8 L27 41.5 L27 39.5 Z"
                fill="rgba(201,168,76,0.14)"/>

          <!-- Grosor inferior derecha -->
          <path d="M49 44 L46.5 45.8 L29 41.5 L29 39.5 Z"
                fill="rgba(201,168,76,0.08)"/>

          <!-- Lomo — gradiente vertical con glow -->
          <line x1="28" y1="11" x2="28" y2="39.5"
                stroke="url(#lgoldV)" stroke-width="2.8"
                stroke-linecap="round" filter="url(#lglow)"/>

          <!-- Ornamento superior: diamante multicapa -->
          <path d="M28 4 L31 9.5 L28 12.5 L25 9.5 Z" fill="url(#lgoldV)" filter="url(#lglowS)"/>
          <path d="M28 5.5 L30 9.5 L28 11.5 L26 9.5 Z" fill="#f5e090" opacity="0.55"/>
          <path d="M28 7 L29 9.5 L28 11 L27 9.5 Z" fill="white" opacity="0.25"/>
          <!-- Cruz sutil en el diamante -->
          <line x1="28" y1="4" x2="28" y2="12.5" stroke="rgba(255,245,200,0.3)" stroke-width="0.4"/>
          <line x1="25" y1="9.5" x2="31" y2="9.5" stroke="rgba(255,245,200,0.2)" stroke-width="0.4"/>

          <!-- Líneas texto pág. izquierda — gradiente horizontal -->
          <line x1="11" y1="19.5" x2="25" y2="18"   stroke="url(#lgoldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.78"/>
          <line x1="11" y1="23.2" x2="25" y2="21.7" stroke="url(#lgoldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.72"/>
          <line x1="11" y1="26.9" x2="25" y2="25.4" stroke="url(#lgoldH)" stroke-width="1.05" stroke-linecap="round" opacity="0.60"/>
          <line x1="11" y1="30.6" x2="21" y2="29.4" stroke="url(#lgoldH)" stroke-width="1"    stroke-linecap="round" opacity="0.42"/>
          <line x1="11" y1="34.3" x2="24" y2="33"   stroke="url(#lgoldH)" stroke-width="0.9"  stroke-linecap="round" opacity="0.32"/>

          <!-- Líneas texto pág. derecha -->
          <line x1="31" y1="18"   x2="45.5" y2="19.5" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.44"/>
          <line x1="31" y1="21.7" x2="45.5" y2="23.2" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.38"/>
          <line x1="31" y1="25.4" x2="45.5" y2="26.9" stroke="#c9a84c" stroke-width="0.95" stroke-linecap="round" opacity="0.30"/>
          <line x1="31" y1="29.2" x2="41"   y2="30.5" stroke="#c9a84c" stroke-width="0.9"  stroke-linecap="round" opacity="0.22"/>

          <!-- Curva inferior páginas -->
          <path d="M7 44 Q12.5 48.5 20 47 L27 45"
                stroke="#c9a84c" stroke-width="1" fill="none"
                opacity="0.38" stroke-linecap="round"/>
          <path d="M49 44 Q43.5 48.5 36 47 L29 45"
                stroke="#c9a84c" stroke-width="1" fill="none"
                opacity="0.26" stroke-linecap="round"/>

          <!-- Puntos encuadernación -->
          <circle cx="7"  cy="15.5" r="1.6" fill="#c9a84c"  opacity="0.80" filter="url(#lglow)"/>
          <circle cx="7"  cy="15.5" r="0.8" fill="#f5e090"  opacity="0.70"/>
          <circle cx="49" cy="15.5" r="1.6" fill="#c9a84c"  opacity="0.48"/>
