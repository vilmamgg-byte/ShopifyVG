    <!-- ── Encabezado ── -->
    <div class="faq-hero">
      <span class="faq-label el-anim">Preguntas frecuentes</span>
      <h1 class="faq-title el-anim el-anim-d1">
        Claridad antes<br>
        <span class="faq-gold">de comenzar</span>
      </h1>
      <p class="faq-subtitle el-anim el-anim-d2">
