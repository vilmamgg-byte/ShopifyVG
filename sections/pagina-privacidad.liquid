{{ 'ebook-landing.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

<style>
  #shopify-section-group-header-group,
  #shopify-section-group-footer-group,
  .skip-to-content-link { display: none !important; }
  body, #MainContent { background: #050505 !important; color: rgba(255,255,255,.78) !important; margin: 0 !important; padding: 0 !important; }
</style>

{%- render 'premium-header' -%}

<div class="shopify-policy__container policy--privacy-policy">
  <div class="shopify-policy__title">
    <div class="pp-eyebrow"><span class="pp-dot"></span>Política de Privacidad</div>
    <h1>Privacidad y confianza</h1>
    <p class="pp-subtitle">Información clara sobre cómo se recopilan, utilizan y protegen tus datos al utilizar Disciplina Imparable.</p>
  </div>
  <div class="shopify-policy__body">
    {{ shop.privacy_policy.body | replace: 'vilmamgg@gmail.com', 'contacto@disciplinaimparable.com' | replace: 'fwzcy7-3h.myshopify.com', 'disciplinaimparable.com' }}
  </div>
</div>

{%- assign pp_handle = 'privacidad' -%}
{%- render 'premium-footer', policy_handle: pp_handle -%}

{{ 'ebook-landing.js' | asset_url | script_tag }}

{% schema %}
{ "name": "Privacidad Premium", "settings": [] }
{% endschema %}
