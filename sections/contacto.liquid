            <linearGradient id="ct-pageL" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.20"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0.05"/></linearGradient>
