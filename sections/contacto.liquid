          <line x1="28" y1="11" x2="28" y2="39.5" stroke="url(#ct-goldV)" stroke-width="2.8" stroke-linecap="round" filter="url(#ct-glow)"/>
          <path d="M28 4 L31 9.5 L28 12.5 L25 9.5 Z" fill="url(#ct-goldV)" filter="url(#ct-glowS)"/>
