  </header>

  <div class="contacto-page">

    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 40% at 50% 0%,rgba(201,168,76,0.05) 0%,transparent 55%);pointer-events:none;z-index:1;"></div>

    <!-- ── Encabezado ── -->
    <div class="contacto-hero">
      <span class="contacto-label el-anim">Contacto</span>
      <h1 class="contacto-title el-anim el-anim-d1">Estamos aquí para ayudarte</h1>
      <p class="contacto-subtitle el-anim el-anim-d2">
        Si tienes dudas sobre el método, el acceso digital o el proceso de compra, puedes escribirnos. Te responderemos con claridad y atención.
      </p>
    </div>

    <!-- Divisor -->
    <div class="contacto-divider el-anim el-anim-d3"></div>

    <!-- ── Cuerpo ── -->
    <div class="contacto-body">

      <!-- Información -->
      <div class="contacto-info el-anim el-anim-d1">

        <div class="contacto-info-item">
          <span class="contacto-info-label">Correo</span>
          <span class="contacto-info-value">
            <a href="mailto:contacto@disciplinaimparable.com">contacto@disciplinaimparable.com</a>
          </span>
        </div>

        <div class="contacto-info-sep"></div>

        <div class="contacto-info-item">
          <span class="contacto-info-label">Tiempo de respuesta</span>
          <span class="contacto-info-value">24 a 48 horas hábiles</span>
        </div>

        <div class="contacto-info-sep"></div>

        <p class="contacto-info-note">
          Para consultas relacionadas con compras, por favor incluye el correo utilizado al realizar el pedido.
        </p>

      </div>

      <!-- Formulario -->
      <div class="contacto-form-wrap el-anim el-anim-d2">
        {%- form 'contact', id: 'ContactFormPremium' -%}

          {%- if form.posted_successfully? -%}
            <div class="contacto-success" tabindex="-1" autofocus>
              <strong>Mensaje enviado</strong>
              Tu mensaje ha llegado. Te responderemos en un plazo de 24 a 48 horas hábiles.
            </div>

          {%- else -%}

            {%- if form.errors -%}
              <p class="contacto-error">
                Por favor revisa el campo de correo electrónico e inténtalo de nuevo.
              </p>
            {%- endif -%}

            <div class="contacto-field">
              <label for="ContactFormPremium-name">Nombre</label>
              <input
                type="text"
                id="ContactFormPremium-name"
                name="contact[Nombre]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Tu nombre"
              >
            </div>

            <div class="contacto-field">
              <label for="ContactFormPremium-email">Correo electrónico <span aria-hidden="true" style="color:rgba(201,168,76,0.5)">*</span></label>
              <input
                type="email"
                id="ContactFormPremium-email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                aria-required="true"
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="tu@correo.com"
              >
            </div>

            <div class="contacto-field">
              <label for="ContactFormPremium-body">Mensaje</label>
              <textarea
                id="ContactFormPremium-body"
                name="contact[Mensaje]"
                placeholder="Cuéntanos en qué podemos ayudarte..."
              >{{- form.body -}}</textarea>
            </div>

            <button type="submit" class="contacto-btn">
              Enviar mensaje
            </button>

          {%- endif -%}

        {%- endform -%}
      </div>

    </div>

    <!-- Footer -->
    <footer class="el-cierre-footer">
      <div class="el-cierre-footer-inner">
        <nav class="el-cierre-nav" aria-label="Footer">
          <a href="/#la-voz">Sobre la Autora</a>
          <span class="el-cierre-sep" aria-hidden="true">·</span>
          <a href="#" rel="noopener">Instagram</a>
          <span class="el-cierre-sep" aria-hidden="true">·</span>
          <a href="/pages/contacto" style="color:rgba(212,175,55,1)">Contacto</a>
          <span class="el-cierre-sep" aria-hidden="true">·</span>
          <a href="/policies/privacy-policy">Privacidad</a>
          <span class="el-cierre-sep" aria-hidden="true">·</span>
          <a href="/policies/terms-of-service">Términos</a>
        </nav>
        <p class="el-cierre-copy">© 2026 Disciplina Imparable</p>
      </div>
    </footer>

  </div><!-- /contacto-page -->

</div><!-- /el-page -->

