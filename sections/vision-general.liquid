          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="rgba(0,0,0,0.25)" transform="translate(1,1.5)"/>
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="url(#vg-pageL)" stroke="#c9a84c" stroke-width="1.05" stroke-linejoin="round"/>
          <path d="M25.5 13 L9.5 17 L9.5 42 L25.5 38 Z" fill="rgba(255,255,255,0.022)"/>
