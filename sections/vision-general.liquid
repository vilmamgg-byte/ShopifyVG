{{ 'ebook-landing.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-group-header-group,
  .shopify-section-group--header-group,
  sticky-header { display: none !important; }
  body { padding-top: 0 !important; margin-top: 0 !important; }
</style>

<div class="el-page">

  <!-- Mobile nav -->
  <div class="el-mobile-nav" aria-hidden="true">
    <a href="/">Inicio</a>
    <a href="/pages/vision-general">Método Imparable</a>
    <a href="/pages/vision-general" class="el-mobile-sub">↳ Visión General</a>
    <a href="/pages/lo-que-aprenderas" class="el-mobile-sub">↳ Lo Que Aprenderás</a>
    <a href="/pages/beneficios">Beneficios</a>
    <a href="/pages/resultados">Resultados</a>
    <a href="/pages/testimonios">Testimonios</a>
    <a href="/#el-faq">FAQ</a>
    <a href="/pages/shopifyvg" class="el-nav-cta">Obtener Ahora</a>
  </div>

  <!-- Header -->
  <header class="el-header" id="el-header">
    <a href="/" class="el-logo">
      <div class="el-logo-mark">
        <svg width="30" height="30" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="vg-goldH" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#c9a84c"/><stop offset="50%" stop-color="#f0d878"/><stop offset="100%" stop-color="#c9a84c"/></linearGradient>
            <linearGradient id="vg-goldV" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#f5e090"/><stop offset="45%" stop-color="#c9a84c"/><stop offset="100%" stop-color="#8a6820"/></linearGradient>
            <linearGradient id="vg-pageL" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.20"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0.05"/></linearGradient>
            <linearGradient id="vg-pageR" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.11"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0.03"/></linearGradient>
            <radialGradient id="vg-aura" cx="50%" cy="55%" r="50%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.10"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0"/></radialGradient>
            <filter id="vg-glow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="1.2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            <filter id="vg-glowS" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <ellipse cx="28" cy="33" rx="22" ry="19" fill="url(#vg-aura)"/>
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="rgba(0,0,0,0.25)" transform="translate(1,1.5)"/>
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="url(#vg-pageL)" stroke="#c9a84c" stroke-width="1.05" stroke-linejoin="round"/>
          <path d="M25.5 13 L9.5 17 L9.5 42 L25.5 38 Z" fill="rgba(255,255,255,0.022)"/>
          <path d="M29 11 L49 15.5 L49 44 L29 39.5 Z" fill="url(#vg-pageR)" stroke="#c9a84c" stroke-width="0.8" stroke-linejoin="round"/>
          <path d="M7 44 L9.5 45.8 L27 41.5 L27 39.5 Z" fill="rgba(201,168,76,0.14)"/>
          <path d="M49 44 L46.5 45.8 L29 41.5 L29 39.5 Z" fill="rgba(201,168,76,0.08)"/>
          <line x1="28" y1="11" x2="28" y2="39.5" stroke="url(#vg-goldV)" stroke-width="2.8" stroke-linecap="round" filter="url(#vg-glow)"/>
          <path d="M28 4 L31 9.5 L28 12.5 L25 9.5 Z" fill="url(#vg-goldV)" filter="url(#vg-glowS)"/>
          <path d="M28 5.5 L30 9.5 L28 11.5 L26 9.5 Z" fill="#f5e090" opacity="0.55"/>
          <line x1="11" y1="19.5" x2="25" y2="18" stroke="url(#vg-goldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.78"/>
          <line x1="11" y1="23.2" x2="25" y2="21.7" stroke="url(#vg-goldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.72"/>
          <line x1="11" y1="26.9" x2="25" y2="25.4" stroke="url(#vg-goldH)" stroke-width="1.05" stroke-linecap="round" opacity="0.60"/>
          <line x1="31" y1="18" x2="45.5" y2="19.5" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.44"/>
          <line x1="31" y1="21.7" x2="45.5" y2="23.2" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.38"/>
          <circle cx="7" cy="15.5" r="1.6" fill="#c9a84c" opacity="0.80" filter="url(#vg-glow)"/>
          <circle cx="7" cy="15.5" r="0.8" fill="#f5e090" opacity="0.70"/>
          <circle cx="28" cy="11" r="1.6" fill="#f5e090" opacity="0.65"/>
          <circle cx="28" cy="11" r="0.7" fill="white" opacity="0.60"/>
        </svg>
      </div>
      <span class="el-logo-text"><span class="el-logo-d">DISCIPLINA</span><span class="el-logo-i">IMPARABLE</span></span>
    </a>
    <nav class="el-nav" aria-label="Navegación principal">
      <a href="/">Inicio</a>

      <div class="el-dropdown" role="navigation">
        <button class="el-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Método Imparable
          <svg class="el-dropdown-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="el-dropdown-panel" role="menu">
          <a href="/pages/vision-general" class="el-dropdown-item" role="menuitem" style="color:#c9a84c">
            <span class="el-dropdown-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            </span>
            <span>
              <strong>Visión General</strong>
              <small>Qué es y cómo funciona</small>
            </span>
          </a>
          <a href="/pages/lo-que-aprenderas" class="el-dropdown-item" role="menuitem">
            <span class="el-dropdown-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7l2-7z"/></svg>
            </span>
            <span>
              <strong>Lo Que Aprenderás</strong>
              <small>Contenido y resultados</small>
            </span>
          </a>
        </div>
      </div>

      <a href="/pages/beneficios">Beneficios</a>
      <a href="/pages/resultados">Resultados</a>
      <a href="/pages/testimonios">Testimonios</a>
      <a href="/#el-faq">FAQ</a>
      <a href="/pages/shopifyvg" class="el-nav-cta">Obtener Ahora</a>
    </nav>

    <button class="el-mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Hero de página -->
  <section style="min-height:38vh;display:flex;align-items:center;background:var(--el-deep);padding:130px 48px 28px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 50% 0%,rgba(201,168,76,0.07) 0%,transparent 65%);pointer-events:none;"></div>
    <div class="el-container" style="position:relative;z-index:2;">
      <h1 class="el-anim" style="font-size:clamp(52px,7vw,96px);font-weight:800;letter-spacing:-0.02em;line-height:0.95;margin-bottom:20px;background:linear-gradient(90deg,#c9a84c 0%,#f5e090 40%,#c9a84c 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
        Visión<br>General
      </h1>
      <p class="el-anim el-anim-d1" style="max-width:520px;margin-bottom:0;font-family:'Poppins',sans-serif;font-size:16px;font-weight:300;color:rgba(220,208,185,0.85);line-height:1.75;letter-spacing:0.02em;">
        Un sistema de transformación real para quienes ya saben lo que quieren
        y están listos para construir la disciplina que lo hace posible.
      </p>
    </div>
  </section>

  <!-- ─── Bloque compacto: principios + diferenciador + para quién ─── -->
  <section class="el-section" style="padding-top:36px;">
    <div class="el-container">

      <!-- Frase + pills -->
      <div class="el-anim" style="text-align:center;margin-bottom:36px;">
        <p style="font-family:var(--el-font-serif);font-style:italic;font-size:clamp(16px,1.6vw,20px);color:#dfd0b4;line-height:1.65;margin-bottom:24px;">
          "La disciplina deja de ser motivación temporal y se convierte en una forma de vivir."
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;">
          {% assign principios = "Disciplina mental,Enfoque profundo,Hábitos,Control emocional,Ejecución constante,Desarrollo estratégico" | split: "," %}
          {% for p in principios %}
            <span style="background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.25);color:#dfc97a;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:6px 14px;border-radius:100px;">{{ p }}</span>
          {% endfor %}
        </div>
      </div>

      <!-- Diferenciador + Para quién: dos columnas -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;" class="el-anim el-anim-d1">

        <!-- Columna A: Qué hace diferente -->
        <div style="background:rgba(201,168,76,0.05);border:1px solid rgba(201,168,76,0.20);border-radius:16px;padding:28px 26px;">
          <p style="font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--el-gold);margin-bottom:18px;">El Método Imparable enfocado en:</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
            {% assign checks = "Eliminar excusas,Crear acción constante,Fortalecer la mente,Recuperar el enfoque,Construir hábitos sólidos,Disciplina sin depender de motivación" | split: "," %}
            {% for item in checks %}
            <li style="display:flex;align-items:center;gap:9px;color:var(--el-light);font-size:14px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c9a84c" stroke-width="2.5" style="flex-shrink:0"><path d="M20 6L9 17l-5-5"/></svg>
              {{ item }}
            </li>
            {% endfor %}
          </ul>
        </div>

        <!-- Columna B: Para quién es -->
        <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);border-radius:16px;padding:28px 26px;">
          <p style="font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--el-gray);margin-bottom:18px;">Es para ti si:</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
            {% assign para_quien = "Sientes que puedes dar mucho más,Quieres recuperar el control de tu vida,Cansado de empezar y abandonar,Buscas claridad mental y enfoque,Quieres resultados reales" | split: "," %}
            {% for item in para_quien %}
            <li style="display:flex;align-items:center;gap:9px;color:var(--el-light);font-size:14px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(201,168,76,0.55)" stroke-width="2" style="flex-shrink:0"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9S3 16.97 3 12 7.03 3 12 3s9 4.03 9 9z"/></svg>
              {{ item }}
            </li>
            {% endfor %}
          </ul>
        </div>

      </div>

      <!-- Cita de cierre + CTA -->
      <div class="el-anim" style="text-align:center;margin-top:44px;padding-top:40px;border-top:1px solid var(--el-border);">
        <p style="font-family:var(--el-font-serif);font-style:italic;font-size:16px;color:#dfd0b4;margin-bottom:28px;">
          "Lo que comienza como lectura… termina convirtiéndose en transformación."
        </p>
        <a href="/pages/lo-que-aprenderas" class="el-btn-outline" style="margin-right:16px;">Ver los 6 módulos →</a>
        <a href="/pages/shopifyvg" class="el-btn-gold">Obtener Ahora</a>
      </div>

    </div>
  </section>

  <!-- Footer mínimo -->
  <footer style="background:var(--el-deep);border-top:1px solid var(--el-border);padding:32px 48px;text-align:center;">
    <a href="/" class="el-logo" style="justify-content:center;margin-bottom:12px;">
      <span class="el-logo-text"><span class="el-logo-d">DISCIPLINA</span><span class="el-logo-i">IMPARABLE</span></span>
    </a>
    <p style="font-size:13px;color:var(--el-gray);margin:0;">© 2026 Disciplina Imparable. Todos los derechos reservados.</p>
  </footer>

</div>

{{ 'ebook-landing.js' | asset_url | script_tag }}

