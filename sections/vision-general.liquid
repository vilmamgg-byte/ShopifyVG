          <path d="M28 4 L31 9.5 L28 12.5 L25 9.5 Z" fill="url(#vg-goldV)" filter="url(#vg-glowS)"/>
          <path d="M28 5.5 L30 9.5 L28 11.5 L26 9.5 Z" fill="#f5e090" opacity="0.55"/>
          <line x1="11" y1="19.5" x2="25" y2="18" stroke="url(#vg-goldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.78"/>
          <line x1="11" y1="23.2" x2="25" y2="21.7" stroke="url(#vg-goldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.72"/>
          <line x1="11" y1="26.9" x2="25" y2="25.4" stroke="url(#vg-goldH)" stroke-width="1.05" stroke-linecap="round" opacity="0.60"/>
          <line x1="31" y1="18" x2="45.5" y2="19.5" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.44"/>
          <line x1="31" y1="21.7" x2="45.5" y2="23.2" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.38"/>
          <circle cx="7" cy="15.5" r="1.6" fill="#c9a84c" opacity="0.80" filter="url(#vg-glow)"/>
          <circle cx="7" cy="15.5" r="0.8" fill="#f5e090" opacity="0.70"/>
          <circle cx="28" cy="11" r="1.6" fill="#f5e090" opacity="0.65"/>
