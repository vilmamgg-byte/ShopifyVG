  <!-- Hero de página -->
  <section style="background:var(--el-deep);padding:122px 48px 22px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 50% 0%,rgba(201,168,76,0.07) 0%,transparent 65%);pointer-events:none;"></div>

    <div class="el-container" style="position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:start;">

      <!-- IZQUIERDA: título + párrafo -->
      <div style="padding-right:52px;">
        <h1 class="el-anim" style="font-size:clamp(44px,5.99vw,83px);font-weight:800;letter-spacing:-0.02em;line-height:0.95;margin-bottom:18px;background:linear-gradient(90deg,#ffffff 0%,#f5e8c0 35%,#fffcf0 65%,#ffffff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
          Visión<br>General
        </h1>
        <p class="el-anim el-anim-d1" style="font-family:'Poppins',sans-serif;font-size:18px;font-weight:300;color:rgba(228,215,190,0.92);line-height:1.7;letter-spacing:0.01em;margin:0;">
          Un sistema de transformación real para quienes<br>
          saben lo que quieren y están listos<br>
          para construirlo.
        </p>
      </div>

      <!-- DERECHA: línea + La visión del libro -->
      <div class="el-anim el-anim-d1" style="border-left:2px solid rgba(201,168,76,0.40);padding-left:52px;">
        <p style="font-size:16px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin:0 0 16px;">La visión del libro</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">

          {% assign vitem = "display:flex;align-items:center;gap:12px;padding:8px 0;" %}

          <div style="{{ vitem }}">
            <div style="width:56px;height:56px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 47% 36%,#e8c564 0%,#cfa030 38%,#a87820 68%,#7a5414 100%);border-radius:50% 48% 52% 47% / 52% 54% 46% 51%;box-shadow:0 6px 16px rgba(0,0,0,0.52),inset 0 0 0 5px rgba(90,55,8,0.42),inset 0 0 0 4px rgba(230,190,70,0.16),inset 0 2px 4px rgba(255,228,110,0.20),inset 0 -3px 6px rgba(0,0,0,0.22);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,248,200,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 01-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z"/></svg>
            </div>
            <span style="font-size:15px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#e8c96a;">Disciplina Mental</span>
          </div>

          <div style="{{ vitem }}">
            <div style="width:56px;height:56px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 47% 36%,#e8c564 0%,#cfa030 38%,#a87820 68%,#7a5414 100%);border-radius:50% 48% 52% 47% / 52% 54% 46% 51%;box-shadow:0 6px 16px rgba(0,0,0,0.52),inset 0 0 0 5px rgba(90,55,8,0.42),inset 0 0 0 4px rgba(230,190,70,0.16),inset 0 2px 4px rgba(255,228,110,0.20),inset 0 -3px 6px rgba(0,0,0,0.22);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,248,200,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="22"/><line x1="2" y1="12" x2="8" y2="12"/><line x1="16" y1="12" x2="22" y2="12"/></svg>
            </div>
            <span style="font-size:15px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#e8c96a;">Enfoque Profundo</span>
          </div>

          <div style="{{ vitem }}">
            <div style="width:56px;height:56px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 47% 36%,#e8c564 0%,#cfa030 38%,#a87820 68%,#7a5414 100%);border-radius:50% 48% 52% 47% / 52% 54% 46% 51%;box-shadow:0 6px 16px rgba(0,0,0,0.52),inset 0 0 0 5px rgba(90,55,8,0.42),inset 0 0 0 4px rgba(230,190,70,0.16),inset 0 2px 4px rgba(255,228,110,0.20),inset 0 -3px 6px rgba(0,0,0,0.22);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,248,200,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 019-9 9.75 9.75 0 016.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 01-9 9 9.75 9.75 0 01-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
            </div>
            <span style="font-size:15px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#e8c96a;">Hábitos Duraderos</span>
          </div>

          <div style="{{ vitem }}">
            <div style="width:56px;height:56px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 47% 36%,#e8c564 0%,#cfa030 38%,#a87820 68%,#7a5414 100%);border-radius:50% 48% 52% 47% / 52% 54% 46% 51%;box-shadow:0 6px 16px rgba(0,0,0,0.52),inset 0 0 0 5px rgba(90,55,8,0.42),inset 0 0 0 4px rgba(230,190,70,0.16),inset 0 2px 4px rgba(255,228,110,0.20),inset 0 -3px 6px rgba(0,0,0,0.22);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,248,200,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <span style="font-size:15px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#e8c96a;">Control Emocional</span>
          </div>

          <div style="{{ vitem }}">
            <div style="width:56px;height:56px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 47% 36%,#e8c564 0%,#cfa030 38%,#a87820 68%,#7a5414 100%);border-radius:50% 48% 52% 47% / 52% 54% 46% 51%;box-shadow:0 6px 16px rgba(0,0,0,0.52),inset 0 0 0 5px rgba(90,55,8,0.42),inset 0 0 0 4px rgba(230,190,70,0.16),inset 0 2px 4px rgba(255,228,110,0.20),inset 0 -3px 6px rgba(0,0,0,0.22);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,248,200,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <span style="font-size:15px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#e8c96a;">Ejecución Constante</span>
          </div>

          <div style="{{ vitem }}">
            <div style="width:56px;height:56px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 47% 36%,#e8c564 0%,#cfa030 38%,#a87820 68%,#7a5414 100%);border-radius:50% 48% 52% 47% / 52% 54% 46% 51%;box-shadow:0 6px 16px rgba(0,0,0,0.52),inset 0 0 0 5px rgba(90,55,8,0.42),inset 0 0 0 4px rgba(230,190,70,0.16),inset 0 2px 4px rgba(255,228,110,0.20),inset 0 -3px 6px rgba(0,0,0,0.22);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,248,200,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            </div>
            <span style="font-size:15px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#e8c96a;">Desarrollo Estratégico</span>
          </div>

        </div>
      </div>

    </div>

    <!-- CITA: una sola línea al fondo -->
    <div class="el-container el-anim" style="position:relative;z-index:2;margin-top:32px;padding-top:24px;text-align:center;border-top:1px solid rgba(201,168,76,0.15);">
      <p class="el-quote-premium">
        "La disciplina deja de ser motivación temporal y se convierte en una forma de vivir."
        <span style="font-family:'Poppins',sans-serif;font-size:10px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:rgba(201,168,76,0.65);margin-left:14px;font-style:normal;">— Disciplina Imparable</span>
      </p>
    </div>

  </section>

  <!-- ─── Bloque compacto: diferenciador + para quién ─── -->
  <section class="el-section" style="padding-top:0;">
    <div class="el-container">

      <!-- separador visual eliminado — flujo directo -->
      <!-- Títulos sobre los recuadros — 3 columnas: botón | Y-flecha | botón -->
      <div style="display:grid;grid-template-columns:1fr auto 1fr;column-gap:28px;align-items:center;margin-bottom:19px;">

        <!-- Título izquierdo — 4 hojas + corte diagonal sup. derecha dorado -->
        <div style="position:relative;margin-top:12px;margin-right:12px;">
          <div style="position:absolute;inset:0;transform:translate(10px,-10px);border:1px solid rgba(201,168,76,0.08);background:var(--el-deep);clip-path:polygon(0% 0%,calc(100% - 18px) 0%,100% 18px,100% 100%,0% 100%);"></div>
          <div style="position:absolute;inset:0;transform:translate(7px,-7px);border:1px solid rgba(201,168,76,0.14);background:var(--el-deep);clip-path:polygon(0% 0%,calc(100% - 18px) 0%,100% 18px,100% 100%,0% 100%);"></div>
          <div style="position:absolute;inset:0;transform:translate(4px,-4px);border:1px solid rgba(201,168,76,0.24);background:var(--el-deep);clip-path:polygon(0% 0%,calc(100% - 18px) 0%,100% 18px,100% 100%,0% 100%);"></div>
          <svg style="position:absolute;top:0;right:0;z-index:2;pointer-events:none;" width="19" height="19" viewBox="0 0 18 18" fill="none">
            <path d="M0 0 L18 0 L18 18 Z" fill="rgba(201,168,76,0.38)"/>
            <line x1="0" y1="0" x2="18" y2="18" stroke="#c9a84c" stroke-opacity="0.80" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          <div style="position:relative;z-index:1;clip-path:polygon(0% 0%,calc(100% - 18px) 0%,100% 18px,100% 100%,0% 100%);border:1px solid rgba(201,168,76,0.44);padding:14px 22px;display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,rgba(201,168,76,0.08) 0%,rgba(201,168,76,0.03) 100%);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c9a84c" stroke-width="2" style="flex-shrink:0"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            <h3 style="margin:0;font-size:16px;font-family:'Poppins',sans-serif;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#c9a84c;">Qué hace diferente a este método</h3>
          </div>
        </div>

        <!-- Centro: estrella 4 puntas luxury — mitad dorada izq., mitad blanca der. -->
        <div class="el-arrow-down" style="display:flex;flex-direction:column;align-items:center;width:44px;">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="star-hw" x1="0" y1="0" x2="44" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="50%" stop-color="#c9a84c" stop-opacity="0.88"/>
                <stop offset="50%" stop-color="#ffffff" stop-opacity="0.68"/>
              </linearGradient>
              <linearGradient id="star-hw-f" x1="0" y1="0" x2="44" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="50%" stop-color="#c9a84c" stop-opacity="0.07"/>
                <stop offset="50%" stop-color="#ffffff" stop-opacity="0.05"/>
              </linearGradient>
            </defs>
            <path d="M22 2 C20 12 12 20 2 22 C12 24 20 32 22 42 C24 32 32 24 42 22 C32 20 24 12 22 2 Z" fill="url(#star-hw-f)" stroke="url(#star-hw)" stroke-width="1.1" stroke-linejoin="round"/>
            <circle cx="22" cy="22" r="2.4" fill="rgba(201,168,76,0.15)" stroke="url(#star-hw)" stroke-width="0.9"/>
            <circle cx="22" cy="22" r="0.9" fill="url(#star-hw)" opacity="0.60"/>
          </svg>
        </div>

        <!-- Título derecho — 4 hojas + corte diagonal sup. izquierda crema -->
        <div style="position:relative;margin-top:12px;margin-left:12px;">
          <div style="position:absolute;inset:0;transform:translate(-10px,-10px);border:1px solid rgba(228,215,190,0.06);background:var(--el-deep);clip-path:polygon(18px 0%,100% 0%,100% 100%,0% 100%,0% 18px);"></div>
          <div style="position:absolute;inset:0;transform:translate(-7px,-7px);border:1px solid rgba(228,215,190,0.11);background:var(--el-deep);clip-path:polygon(18px 0%,100% 0%,100% 100%,0% 100%,0% 18px);"></div>
          <div style="position:absolute;inset:0;transform:translate(-4px,-4px);border:1px solid rgba(228,215,190,0.19);background:var(--el-deep);clip-path:polygon(18px 0%,100% 0%,100% 100%,0% 100%,0% 18px);"></div>
