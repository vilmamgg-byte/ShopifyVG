<style>
  #shopify-section-group-header-group, 
  .shopify-section-group--header-group,
  sticky-header { display: none !important; }
  body { padding-top: 0 !important; margin-top: 0 !important; }
  #vg-hero h1 { font-size: clamp(23px,3.1vw,44px) !important; }
  #vg-hero p.el-anim { font-size: 20px !important; }
  @keyframes el-nudge { 0%,100%{transform:translateY(0)} 50%{transform:translateY(4px)} }
  .el-arrow-down { animation: el-nudge 2.2s ease-in-out infinite; display:flex; align-items:center; }
  .el-quote-premium {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(14px, 1.66vw, 21px);
    color: #f0dab8;
    letter-spacing: 0.01em;
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 0 60px rgba(201,168,76,0.28), 0 1px 0 rgba(0,0,0,0.18);
  }
  html, body {
    overflow: hidden !important;
    height: 100vh !important;
    max-height: 100vh !important;
  }
  .el-page {
    overflow: hidden !important;
    height: 100vh !important;
  }
  .el-header {
    position: fixed !important;
    top: 0 !important; left: 0 !important;
    width: 100% !important;
    z-index: 1000 !important;
    pointer-events: auto !important;
  }
  .fp-nav {
    position: fixed;
    right: 28px; top: 50%;
    transform: translateY(-50%);
    z-index: 900;
    display: flex; flex-direction: column; gap: 12px;
    list-style: none; margin: 0; padding: 0;
  }
  .fp-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.35);
    cursor: pointer;
    transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
    padding: 0; display: block;
  }
  .fp-dot:hover { background: rgba(255,255,255,0.4); }
  .fp-dot--active {
    background: rgba(201,168,76,0.9) !important;
    border-color: rgba(201,168,76,0.7) !important;
    transform: scale(1.6) !important;
  }
  @media (max-width: 768px) {
    .fp-nav { right: 14px; gap: 10px; }
    .fp-dot { width: 6px; height: 6px; }
  }
  .el-cierre-footer {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 0 min(8vw, 80px) 18px;
    z-index: 3;
    border-top: 1px solid rgba(255,255,255,0.06);
    opacity: 0.70;
    transition: opacity 0.4s ease;
  }
  .el-cierre-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
    margin: 10px auto 0;
    gap: 8px;
  }
  .el-cierre-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0;
  }
  .el-cierre-nav a {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(212,175,55,0.72);
    text-decoration: none;
    transition: color 0.4s ease;
  }
  .el-cierre-nav a:hover { color: rgba(212,175,55,1); }
  .el-cierre-sep {
    font-size: 9px;
    color: rgba(212,175,55,0.35);
    margin: 0 10px;
    letter-spacing: 0;
    font-weight: 300;
  }
  .el-cierre-copy {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.55);
    margin: 0;
  }
  @media (max-width: 768px) {
    .el-cierre-footer { padding: 0 20px 16px; }
    .el-cierre-sep { margin: 0 7px; }
    .vg-col-divider { display:none !important; }
  }

  /* ── Mobile-only: ocultar por defecto en desktop ── */
  .vg-scroll-arrow  { display: none; }
  #vg-imagen-mobile { display: none; }

  @media (max-width: 768px) {
    /* Activar slide image mobile */
    #vg-imagen-mobile { display: block; }

    /* Hero: ocultar columna imagen + línea divisoria — solo texto */
    #vg-hero .el-container:first-of-type > div.el-anim {
      display: none !important;
    }
    /* Hero: expandir columna texto a ancho completo */
    #vg-hero .el-container:first-of-type {
      grid-template-columns: 1fr !important;
    }
    #vg-hero .el-container:first-of-type > div:first-child {
      padding-right: 0 !important;
    }
    #vg-hero h1            { font-size: 34px !important; margin-bottom: 14px !important; }
    #vg-hero p.el-anim     { font-size: 15.5px !important; line-height: 1.6 !important; }

    /* Flecha de navegación */
    .vg-scroll-arrow {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      margin-top: 18px !important;
      text-decoration: none !important;
      cursor: pointer !important;
    }
  }

  /* ── Refinamiento premium: #vg-diferenciador ── */

  /* 1. Glow dorado muy sutil detrás del título */
  .vg-title-wrap { position: relative; }
  .vg-title-wrap::before {
    content: '';
    position: absolute;
    top: -80%; left: -50%;
    width: 200%; height: 300%;
    background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(201,168,76,0.07) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .vg-title-wrap > * { position: relative; z-index: 1; }

  /* 4. Micro-hover premium en ítems de lista */
  .vg-list-item { transition: color 0.28s ease; cursor: default; }
  .vg-list-item:hover { color: rgba(228,215,190,0.92) !important; }
  .vg-list-dash { transition: width 0.28s ease, background 0.28s ease; }
  .vg-list-item:hover .vg-list-dash {
    width: 26px !important;
    background: rgba(201,168,76,0.70) !important;
  }

  /* 5. Cita inferior refinada */
  .vg-quote-refined { position: relative; }
  .vg-quote-refined::before { display: none; }
</style>

