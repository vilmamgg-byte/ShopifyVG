  .el-arrow-down { animation: el-nudge 2.2s ease-in-out infinite; display:flex; align-items:center; }
  .el-quote-premium {
    font-family: 'Josefin Sans', sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(16px, 1.84vw, 23px);
