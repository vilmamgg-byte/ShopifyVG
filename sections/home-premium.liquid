{{ 'ebook-landing.css' | asset_url | stylesheet_tag }}

<style>
  /* ── Home Page extra styles ── */
  .hp-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--el-deep);
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 120px 48px 80px;
  }

  .hp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 50% 40%, rgba(201,168,76,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 20% 80%, rgba(201,168,76,0.03) 0%, transparent 60%);
    pointer-events: none;
  }

  .hp-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.012) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.012) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);
    pointer-events: none;
  }

  .hp-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
  }

  .hp-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--el-gold-dim);
    border: 1px solid var(--el-gold-border);
    color: var(--el-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: var(--el-r-full);
    margin-bottom: 32px;
  }

  .hp-hero-title {
    font-family: var(--el-font-alt);
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 1.0;
    color: var(--el-white);
    margin-bottom: 28px;
  }

  .hp-hero-title .line-gold {
    display: block;
    background: linear-gradient(135deg, var(--el-gold) 0%, var(--el-gold-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hp-hero-sub {
    font-size: 18px;
    color: var(--el-gray);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 auto 44px;
  }

  .hp-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }

  .hp-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hp-trust-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--el-muted);
  }

  .hp-trust-item svg { color: var(--el-gold); }

  /* ── Featured book ── */
  .hp-featured {
    padding: 100px 48px;
    background: var(--el-dark);
  }

  .hp-featured-inner {
    max-width: var(--el-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hp-book-scene {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hp-book-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(201,168,76,0.15) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(60px);
    animation: el-glow 5s ease-in-out infinite;
    pointer-events: none;
  }

  .hp-book {
    width: 280px;
    height: 390px;
    border-radius: 3px 14px 14px 3px;
    border: 1px solid rgba(201,168,76,0.28);
    box-shadow:
      -6px  0 0 0px #0e0e0e,
      -10px 0 0 0px #0a0a0a,
      -13px 0 0 0px #080808,
      28px 32px 90px rgba(0,0,0,0.88),
      0 0 100px rgba(201,168,76,0.12),
      inset -1px 0 0 rgba(255,255,255,0.05);
    position: relative;
    overflow: hidden;
    animation: el-float 7s ease-in-out infinite;
    transition: transform 0.7s var(--el-ease);
  }

  .hp-book img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
    border-radius: 2px 13px 13px 2px;
    background: #111;
  }

  .hp-book-spine {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: linear-gradient(to bottom, var(--el-gold-bright), var(--el-gold), rgba(201,168,76,0.4), var(--el-gold));
    border-radius: 3px 0 0 3px;
    z-index: 2;
  }

  .hp-book-shine {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 45%;
    background: linear-gradient(to bottom, rgba(255,255,255,0.07) 0%, transparent 100%);
    pointer-events: none;
    border-radius: 2px 13px 0 0;
    z-index: 1;
  }

  .hp-book::before {
    content: '';
    position: absolute;
    top: 0; left: 4px; right: 0;
    height: 1px;
    background: linear-gradient(to right, var(--el-gold), transparent 80%);
    z-index: 2;
    opacity: 0.5;
  }

  .hp-featured-content .el-label { margin-bottom: 16px; }

  .hp-featured-title {
    font-family: var(--el-font-alt);
    font-size: clamp(32px, 3.5vw, 52px);
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.08;
    color: var(--el-white);
    margin-bottom: 20px;
  }

  .hp-featured-desc {
    font-size: 16px;
    color: var(--el-gray);
    line-height: 1.8;
    margin-bottom: 36px;
  }

  .hp-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }

  .hp-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--el-gold-dim);
    border: 1px solid var(--el-gold-border);
    color: var(--el-gold);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--el-r-full);
    letter-spacing: 0.3px;
  }

  /* ── Values ── */
  .hp-values {
    padding: 100px 48px;
    background: var(--el-deep);
  }

  .hp-values-grid {
    max-width: var(--el-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 1px solid var(--el-border);
    border-radius: var(--el-r-xl);
    overflow: hidden;
  }

  .hp-value-item {
    padding: 48px 36px;
    background: var(--el-dark);
    position: relative;
    transition: background 0.3s ease;
  }

  .hp-value-item:hover { background: var(--el-charcoal); }

  .hp-value-item::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 1px;
    height: 100%;
    background: var(--el-border);
  }

  .hp-value-item:last-child::after { display: none; }

  .hp-value-num {
    font-family: var(--el-font-alt);
    font-size: 56px;
    font-weight: 900;
    color: var(--el-gold);
    opacity: 0.2;
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: -2px;
  }

  .hp-value-title {
    font-family: var(--el-font-alt);
    font-size: 22px;
    font-weight: 700;
    color: var(--el-white);
    margin-bottom: 12px;
    letter-spacing: -0.4px;
  }

  .hp-value-desc {
    font-size: 14px;
    color: var(--el-gray);
    line-height: 1.7;
  }

  /* ── Phrase ── */
  .hp-phrase {
    padding: 120px 48px;
    background: var(--el-dark);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hp-phrase::before {
    content: '"';
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--el-font-alt);
    font-size: 300px;
    font-weight: 900;
    color: rgba(201,168,76,0.04);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .hp-phrase-text {
    font-family: var(--el-font-alt);
    font-size: clamp(24px, 3.5vw, 48px);
    font-weight: 700;
    color: var(--el-white);
    line-height: 1.3;
    letter-spacing: -1px;
    max-width: 820px;
    margin: 0 auto 20px;
    position: relative;
    z-index: 1;
  }

  .hp-phrase-author {
    font-size: 14px;
    color: var(--el-gold);
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  /* ── CTA ── */
  .hp-cta {
    padding: 130px 48px;
    background: var(--el-deep);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hp-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(201,168,76,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hp-cta-inner {
    max-width: 640px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hp-cta-title {
    font-family: var(--el-font-alt);
    font-size: clamp(36px, 5vw, 68px);
    font-weight: 900;
    letter-spacing: -2px;
    line-height: 1.05;
    color: var(--el-white);
    margin-bottom: 20px;
  }

  .hp-cta-sub {
    font-size: 17px;
    color: var(--el-gray);
    line-height: 1.7;
    margin-bottom: 44px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hp-featured-inner { grid-template-columns: 1fr; gap: 48px; }
    .hp-book-scene { order: -1; }
    .hp-values-grid { grid-template-columns: 1fr; }
    .hp-value-item::after { top: auto; bottom: 0; left: 0; width: 100%; height: 1px; }
  }

  @media (max-width: 768px) {
    .hp-hero { padding: 110px 24px 72px; }
    .hp-featured { padding: 72px 24px; }
    .hp-values { padding: 72px 24px; }
    .hp-phrase { padding: 80px 24px; }
    .hp-cta { padding: 88px 24px; }
    .hp-hero-title { letter-spacing: -2px; }
    .hp-book { width: 220px; height: 306px; }
    .hp-hero-actions { flex-direction: column; align-items: center; }
  }
</style>

