  <!-- ════════════════════════════════════
       RESULTADOS — sección única premium
  ════════════════════════════════════ -->
  <section class="rs-section">

    <!-- Gradientes de ambiente -->
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 45% at 50% 0%,rgba(201,168,76,0.06) 0%,transparent 58%),radial-gradient(ellipse 28% 32% at 85% 85%,rgba(201,168,76,0.03) 0%,transparent 52%);pointer-events:none;z-index:1;"></div>

    <div class="rs-container">

      <!-- 1 · Encabezado -->
      <span class="rs-label el-anim">Impacto medible</span>
      <h1 class="rs-title el-anim el-anim-d1">
        Resultados que se reflejan <span class="rs-gold">en acción</span>
      </h1>
      <p class="rs-intro el-anim el-anim-d2">
        Claridad, constancia y acción sostenida para avanzar con intención.
      </p>

      <!-- Divisor vertical de respiro -->
