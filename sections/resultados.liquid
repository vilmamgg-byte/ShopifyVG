      <!-- 2 · Contadores animados -->
      <div class="rs-counters el-anim el-anim-d3">

        <div class="rs-stat">
          <div class="rs-stat-num" data-count="21" data-suffix="" data-dec="0">21</div>
          <div class="rs-stat-lbl">Días de práctica</div>
        </div>

        <div class="rs-stat">
          <div class="rs-stat-num" data-count="6" data-suffix="" data-dec="0">6</div>
          <div class="rs-stat-lbl">Módulos</div>
        </div>

        <div class="rs-stat">
          <div class="rs-stat-num" data-count="1" data-suffix="" data-dec="0">1</div>
          <div class="rs-stat-lbl">Sistema de acción</div>
        </div>

      </div>

      <!-- Separador fino horizontal -->
      <div class="rs-sep el-anim el-anim-d4"></div>

      <!-- 3 · Tarjetas de resultados (grid 2×2) -->
