<style>
  #shopify-section-group-header-group,
  .shopify-section-group--header-group,
  sticky-header { display: none !important; }
  #shopify-section-group-footer-group,
  .shopify-section-group--footer-group,
  #shopify-section-footer,
  footer.footer,
  .footer__content-bottom,
  .footer__copyright { display: none !important; }
  body { padding-top: 0 !important; margin-top: 0 !important; }

  /* ── Sección principal ── */
  .bn-section {
    padding: 120px 48px 96px;
    background: var(--el-deep);
    position: relative;
    overflow: hidden;
  }

  /* ── Layout dos columnas 35 / 65 ── */
  .bn-layout {
    display: grid;
    grid-template-columns: 1fr 1.85fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Columna izquierda: ancla editorial ── */
  .bn-anchor {
    position: sticky;
    top: 100px;
  }

  .bn-anchor .el-label {
    display: inline-flex;
    margin-bottom: 22px;
  }

  .bn-anchor-title {
    font-family: var(--el-font-alt);
    font-size: clamp(24px, 2.2vw, 36px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.5px;
    color: var(--el-white);
    margin-bottom: 18px;
  }

  .bn-anchor-sub {
    font-family: var(--el-font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--el-gray);
    line-height: 1.75;
    margin-bottom: 36px;
  }

  .bn-anchor-ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  /* ── Accordion editorial ── */
  .bn-accordion {
    border-top: 1px solid var(--el-border);
  }

  .bn-item {
    border-bottom: 1px solid var(--el-border);
    position: relative;
    transition: background 0.3s ease;
  }

  /* Línea dorada izquierda al activar */
  .bn-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--el-gold);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bn-item.is-open::before {
    opacity: 1;
  }

  .bn-trigger {
    display: grid;
    grid-template-columns: 36px 1fr 20px;
    align-items: center;
    gap: 24px;
    padding: 26px 0 26px 20px;
    cursor: pointer;
    width: 100%;
    background: none;
    border: none;
    color: inherit;
    text-align: left;
    font-family: inherit;
    transition: background 0.2s ease;
  }

  .bn-trigger:hover { background: rgba(255,255,255,0.015); }

  .bn-num {
    font-family: var(--el-font-alt);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--el-muted);
    transition: color 0.25s ease;
    line-height: 1;
  }

  .bn-item.is-open .bn-num {
    color: var(--el-gold);
  }

  .bn-title {
    font-family: var(--el-font-alt);
    font-size: 17px;
    font-weight: 600;
    color: var(--el-white);
    letter-spacing: -0.15px;
    line-height: 1.3;
    transition: color 0.25s ease;
  }

  .bn-item.is-open .bn-title {
    color: var(--el-white);
  }

  /* ── Icono plus/minus ── */
  .bn-icon {
    width: 18px;
    height: 18px;
    position: relative;
    flex-shrink: 0;
    margin-right: 4px;
  }

  .bn-icon span {
    display: block;
    position: absolute;
    background: var(--el-muted);
    border-radius: 1px;
    transition: transform 0.28s var(--el-ease), opacity 0.28s ease, background 0.25s ease;
  }

  .bn-icon .bn-h {
    width: 14px;
    height: 1.5px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .bn-icon .bn-v {
    width: 1.5px;
    height: 14px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .bn-item.is-open .bn-icon span { background: var(--el-gold); }
  .bn-item.is-open .bn-icon .bn-v {
    transform: translate(-50%, -50%) scaleY(0);
    opacity: 0;
  }

  /* ── Cuerpo expandible ── */
  .bn-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bn-item.is-open .bn-body {
    grid-template-rows: 1fr;
  }

  .bn-body-inner {
    overflow: hidden;
    padding: 0 0 0 80px;
  }

  .bn-desc {
    font-size: 14.5px;
    color: var(--el-light);
    line-height: 1.75;
    padding-bottom: 28px;
    max-width: 520px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.28s ease 0.05s, transform 0.28s ease 0.05s;
  }

  .bn-item.is-open .bn-desc {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .bn-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .bn-anchor {
      position: static;
    }
    .bn-anchor-ctas {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .bn-section { padding: 80px 24px 72px; }
    .bn-trigger { padding: 22px 0 22px 16px; gap: 16px; }
    .bn-body-inner { padding-left: 52px; }
    .bn-title { font-size: 16px; }
  }

  /* ── Footer ── */
  .el-cierre-footer {
    background: var(--el-deep);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 0 min(8vw, 80px) 18px;
  }
  .el-cierre-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
    margin: 10px auto 0;
    gap: 8px;
  }
  .el-cierre-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0;
  }
  .el-cierre-nav a {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(212,175,55,0.72);
    text-decoration: none;
    transition: color 0.4s ease;
  }
  .el-cierre-nav a:hover { color: rgba(212,175,55,1); }
  .el-cierre-sep {
    font-size: 9px;
    color: rgba(212,175,55,0.35);
    margin: 0 10px;
    letter-spacing: 0;
    font-weight: 300;
  }
  .el-cierre-copy {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.55);
    margin: 0;
    padding-bottom: 18px;
  }
  @media (max-width: 768px) {
    .el-cierre-footer { padding: 0 20px 16px; }
    .el-cierre-sep { margin: 0 7px; }
  }
</style>

