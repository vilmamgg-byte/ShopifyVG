            <filter id="bn-glowS" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <ellipse cx="28" cy="33" rx="22" ry="19" fill="url(#bn-aura)"/>
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="rgba(0,0,0,0.25)" transform="translate(1,1.5)"/>
          <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="url(#bn-pageL)" stroke="#c9a84c" stroke-width="1.05" stroke-linejoin="round"/>
          <path d="M25.5 13 L9.5 17 L9.5 42 L25.5 38 Z" fill="rgba(255,255,255,0.022)"/>
          <path d="M29 11 L49 15.5 L49 44 L29 39.5 Z" fill="url(#bn-pageR)" stroke="#c9a84c" stroke-width="0.8" stroke-linejoin="round"/>
          <path d="M7 44 L9.5 45.8 L27 41.5 L27 39.5 Z" fill="rgba(201,168,76,0.14)"/>
          <path d="M49 44 L46.5 45.8 L29 41.5 L29 39.5 Z" fill="rgba(201,168,76,0.08)"/>
          <line x1="28" y1="11" x2="28" y2="39.5" stroke="url(#bn-goldV)" stroke-width="2.8" stroke-linecap="round" filter="url(#bn-glow)"/>
          <path d="M28 4 L31 9.5 L28 12.5 L25 9.5 Z" fill="url(#bn-goldV)" filter="url(#bn-glowS)"/>
          <path d="M28 5.5 L30 9.5 L28 11.5 L26 9.5 Z" fill="#f5e090" opacity="0.55"/>
          <line x1="11" y1="19.5" x2="25" y2="18" stroke="url(#bn-goldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.78"/>
          <line x1="11" y1="23.2" x2="25" y2="21.7" stroke="url(#bn-goldH)" stroke-width="1.15" stroke-linecap="round" opacity="0.72"/>
          <line x1="11" y1="26.9" x2="25" y2="25.4" stroke="url(#bn-goldH)" stroke-width="1.05" stroke-linecap="round" opacity="0.60"/>
          <line x1="31" y1="18" x2="45.5" y2="19.5" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.44"/>
          <line x1="31" y1="21.7" x2="45.5" y2="23.2" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.38"/>
          <circle cx="7" cy="15.5" r="1.6" fill="#c9a84c" opacity="0.80" filter="url(#bn-glow)"/>
          <circle cx="7" cy="15.5" r="0.8" fill="#f5e090" opacity="0.70"/>
          <circle cx="28" cy="11" r="1.6" fill="#f5e090" opacity="0.65"/>
          <circle cx="28" cy="11" r="0.7" fill="white" opacity="0.60"/>
        </svg>
      </div>
      <span class="el-logo-d">DISCIPLINA</span><span class="el-logo-sep">·</span><span class="el-logo-i">IMPARABLE</span>
    </a>

    <nav class="el-nav" aria-label="Navegación principal">
      <a href="/">Inicio</a>

      <div class="el-dropdown" role="navigation">
        <button class="el-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Método Imparable
          <svg class="el-dropdown-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="el-dropdown-panel" role="menu">
          <a href="/pages/vision-general" class="el-dropdown-item" role="menuitem">
            <span class="el-dropdown-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            </span>
            <span>
              <strong>Visión General</strong>
              <small>Qué es y cómo funciona</small>
            </span>
          </a>
          <a href="/pages/lo-que-aprenderas" class="el-dropdown-item" role="menuitem">
            <span class="el-dropdown-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7l2-7z"/></svg>
            </span>
            <span>
              <strong>Lo Que Aprenderás</strong>
              <small>Contenido y resultados</small>
            </span>
          </a>
        </div>
      </div>

      <a href="/pages/beneficios" style="color:#c9a84c">Beneficios</a>
      <a href="/pages/testimonios">Resultados</a>
      <a href="/pages/testimonios">Testimonios</a>
      <a href="/#el-faq">FAQ</a>
      <a href="/pages/shopifyvg" class="el-nav-cta">Obtener Ahora</a>
    </nav>

    <button class="el-mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Hero de página -->
  <section style="min-height:38vh;display:flex;align-items:center;background:var(--el-deep);padding:140px 48px 72px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 50% 0%,rgba(201,168,76,0.07) 0%,transparent 65%);pointer-events:none;"></div>
    <div class="el-container" style="position:relative;z-index:2;">
      <span class="el-label el-anim" style="margin-bottom:20px;display:inline-flex;">Por Qué Funciona</span>
      <h1 class="el-hero-title el-anim el-anim-d1" style="font-size:clamp(34px,4vw,58px);max-width:700px;margin-bottom:20px;">
        Diseñado para tu<br>
        <span class="el-gold-text">transformación real</span>
      </h1>
      <p class="el-hero-sub el-anim el-anim-d2" style="max-width:580px;margin-bottom:0;">
        No es teoría. Es un sistema probado que convierte la intención
        en acción y la acción en resultados medibles.
      </p>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="el-section el-section-alt">
    <div class="el-container">

      <div class="el-benefits-grid">

        <article class="el-card el-anim el-anim-d1">
          <div class="el-card-icon">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <div class="el-card-num">01 / Disciplina</div>
          <h3 class="el-card-title">Disciplina Mental</h3>
          <p class="el-card-desc">
            Construye la capacidad de actuar sin depender de la motivación.
            La disciplina es el músculo que separa a los que hablan de los que logran.
          </p>
        </article>

        <article class="el-card el-anim el-anim-d2">
          <div class="el-card-icon">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
            </svg>
          </div>
          <div class="el-card-num">02 / Enfoque</div>
          <h3 class="el-card-title">Enfoque Diario</h3>
          <p class="el-card-desc">
            Sistema de priorización que elimina el ruido y te conecta
            con las acciones de mayor impacto cada mañana, sin excepción.
          </p>
        </article>

        <article class="el-card el-anim el-anim-d3">
          <div class="el-card-icon">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7l2-7z"/>
            </svg>
          </div>
          <div class="el-card-num">03 / Mentalidad</div>
          <h3 class="el-card-title">Mentalidad Fuerte</h3>
          <p class="el-card-desc">
            Reprograma las creencias limitantes. Desarrolla la resiliencia
            emocional que te permite seguir cuando todo te dice que pares.
          </p>
        </article>

        <article class="el-card el-anim el-anim-d4">
          <div class="el-card-icon">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <div class="el-card-num">04 / Resultados</div>
          <h3 class="el-card-title">Resultados Reales</h3>
          <p class="el-card-desc">
            Métricas claras, seguimiento semanal y una hoja de ruta
            para ver progreso tangible en las primeras 3 semanas.
          </p>
        </article>

      </div>

      <div style="text-align:center;margin-top:52px;" class="el-anim">
        <a href="/pages/vision-general" class="el-btn-outline" style="margin-right:16px;">Ver Visión General →</a>
        <a href="/pages/shopifyvg" class="el-btn-gold">Obtener Ahora</a>
      </div>

    </div>
  </section>

  <!-- Footer mínimo -->
  <footer style="background:var(--el-deep);border-top:1px solid var(--el-border);padding:32px 48px;text-align:center;">
    <a href="/" class="el-logo" style="justify-content:center;margin-bottom:12px;">
      <span class="el-logo-d">DISCIPLINA</span><span class="el-logo-sep">·</span><span class="el-logo-i">IMPARABLE</span>
    </a>
    <p style="font-size:13px;color:var(--el-gray);margin:0;">© 2026 Disciplina Imparable. Todos los derechos reservados.</p>
  </footer>

</div>

