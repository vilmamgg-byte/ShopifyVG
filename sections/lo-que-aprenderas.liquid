  /* ── Viewport fijo: todo en una pantalla ── */
  .lq-section {
    height: 100vh;
    padding: 0 72px;
    background: var(--el-deep);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
  }

  .lq-wrap {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 80px;
    padding-bottom: 72px;
    box-sizing: border-box;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    min-height: 0;
  }

  .lq-layout {
    display: grid;
    grid-template-columns: 40fr 60fr;
    align-items: center;
    gap: 0;
    height: 100%;
    position: relative;
    top: -38px;
  }

  .lq-col-left {
    padding-right: 56px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .lq-col-left::after {
    content: '';
    position: absolute;
    right: -38px;
    top: 8%;
    bottom: 8%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(201,168,76,0.16) 25%,
      rgba(201,168,76,0.16) 75%,
      transparent
    );
  }

  .lq-col-right {
    padding-left: 94px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .lq-quote-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    color: rgba(240,218,184,0.45);
    line-height: 1.65;
    border-left: 1px solid rgba(201,168,76,0.22);
    padding-left: 14px;
    margin-bottom: 22px;
  }

  .lq-accordion { width: 100%; min-height: 0; overflow: hidden; }

  /* Eyebrow */
  .lq-eyebrow {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(201,168,76,0.60);
    display: block;
    margin-bottom: 20px;
  }

  /* Párrafo intro */
  .lq-intro {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(228,215,190,0.68);
    line-height: 1.82;
    letter-spacing: 0.02em;
    margin: 0 0 28px;
  }

  /* Micro-beneficios */
  .lq-benefits {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin-bottom: 28px;
  }
  .lq-benefit {
    display: flex;
    align-items: center;
    gap: 13px;
    font-family: 'Poppins', sans-serif;
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: rgba(228,215,190,0.52);
  }
  .lq-benefit::before {
    content: '';
    width: 20px;
    height: 1px;
    background: rgba(201,168,76,0.42);
    flex-shrink: 0;
  }

  /* Frase inspiracional */
  .lq-inspire {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(13px,1.2vw,16px);
    color: rgba(240,218,184,0.32);
    line-height: 1.7;
    border-left: 1px solid rgba(201,168,76,0.18);
    padding-left: 14px;
    margin: 0 0 30px;
  }

  /* CTA dentro de la columna */
  .lq-cta-inline {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: 'Manrope', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(212,175,55,0.70);
    text-decoration: none;
    border: 1px solid rgba(212,175,55,0.28);
    padding: calc(14px - 1mm) 28px;
    background: transparent;
    transition: color 0.35s ease, border-color 0.35s ease;
  }
  .lq-cta-inline:hover {
    color: #d4af37;
    border-color: rgba(212,175,55,0.58);
  }

  /* Footer pegado al fondo de la sección */
  .lq-footer-abs {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: var(--el-deep);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 0 min(8vw, 80px) 16px;
    z-index: 10;
  }

  @media (max-width: 900px) {
    .lq-section { height: auto; padding: 80px 24px 70px; }
    .lq-wrap { padding-top: 0; padding-bottom: 0; height: auto; }
    .lq-layout { grid-template-columns: 1fr; height: auto; }
    .lq-col-left {
      padding-right: 0; padding-bottom: 32px;
      border-right: none; border-bottom: 1px solid rgba(201,168,76,0.14);
      height: auto;
    }
    .lq-col-right { padding-left: 0; height: auto; }
    .lq-footer-abs { position: static; border-top: 1px solid rgba(255,255,255,0.06); }
  }
  .lq-item {
    border-top: 1px solid rgba(201,168,76,0.14);
  }
  .lq-item:last-child {
    border-bottom: 1px solid rgba(201,168,76,0.14);
  }
  .lq-trigger {
    display: flex;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 13px 3px;
    cursor: pointer;
    gap: 24px;
    text-align: left;
  }
  .lq-trigger:focus-visible {
    outline: 1px solid rgba(201,168,76,0.4);
    outline-offset: 2px;
  }
  .lq-num {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.30em;
    color: rgba(212,175,55,0.72);
    min-width: 24px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }
  .lq-name {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(14px, 1.46vw, 17px);
    font-weight: 500;
    color: #ffffff;
    letter-spacing: 0.04em;
    flex: 1;
    transition: color 0.3s ease;
  }
  .lq-icon {
    font-size: 17px;
    font-weight: 200;
    color: rgba(201,168,76,0.60);
    line-height: 1;
    width: 19px;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    transition: color 0.3s ease, transform 0.3s ease;
    flex-shrink: 0;
  }
  .lq-item--open .lq-num { color: rgba(201,168,76,0.90); }
  .lq-item--open .lq-name { color: #c9a84c; }
  .lq-item--open .lq-icon { color: rgba(201,168,76,1); }
  .lq-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.32s cubic-bezier(0.4,0,0.2,1), opacity 0.28s ease;
    opacity: 0;
  }
  .lq-item--open .lq-body {
    max-height: 140px;
    overflow: hidden;
    opacity: 1;
  }
  .lq-list {
    list-style: none;
    padding: 0 3px 12px 48px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .lq-list li {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(228,215,190,0.68);
    line-height: 1.7;
    letter-spacing: 0.02em;
    padding-left: 15px;
    position: relative;
  }
  .lq-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 1px;
    background: rgba(201,168,76,0.50);
  }
  @media (max-width: 768px) {
    .lq-trigger { padding: 14px 3px; gap: 15px; }
    .lq-list { padding-left: 31px; }
  }

  /* ── Animación flecha mobile ── */
  @keyframes lq-nudge { 0%,100%{transform:translateY(0)} 50%{transform:translateY(4px)} }
  .lq-scroll-arrow { display: none; }

  /* ── Nav dots ── */
  .fp-nav {
    position: fixed;
    right: 14px; top: 50%;
    transform: translateY(-50%);
    z-index: 900;
    display: flex; flex-direction: column; gap: 10px;
    list-style: none; margin: 0; padding: 0;
  }
  .fp-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.35);
    cursor: pointer;
    transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
    padding: 0; display: block;
  }
  .fp-dot:hover { background: rgba(255,255,255,0.4); }
  .fp-dot--active {
    background: rgba(201,168,76,0.9) !important;
    border-color: rgba(201,168,76,0.7) !important;
    transform: scale(1.6) !important;
  }

  /* ── Slide 2 acordeón: oculto en desktop ── */
  #lq-slide-acordeon { display: none; }

  /* ── Mobile: sistema de slides ── */
  @media (max-width: 768px) {
    html, body { overflow: hidden !important; height: 100vh !important; max-height: 100vh !important; }
    .el-page { overflow: hidden !important; height: 100vh !important; }

    /* Forzar visibilidad de elementos animados — en slides fixed el observer no dispara */
    .lq-section .el-anim,
    .lq-section .el-hero-title,
    .lq-section .lq-eyebrow {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }

    /* Slide 1: sección principal — solo columna izquierda, pantalla completa */
    .lq-section {
      height: 100vh !important;
      padding: 0 22px !important;
      overflow: hidden !important;
      flex-direction: column !important;
      box-sizing: border-box !important;
      align-items: stretch !important;
    }
    /* Encadenar flex:1 para que space-between funcione de borde a borde */
    .lq-wrap {
      flex: 1 !important;
      padding: 70px 0 6px !important;
      min-height: 0 !important;
      overflow: hidden !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
    }
    .lq-layout {
      flex: 1 !important;
      display: flex !important;
      flex-direction: column !important;
      min-height: 0 !important;
      transform: none !important;
      position: static !important;
      top: auto !important;
    }
    .lq-col-right { display: none !important; }
    .lq-col-left {
      flex: 1 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      border-bottom: none !important;
      border-right: none !important;
      padding: 0 !important;
    }
    .lq-footer-abs { display: none !important; }
    /* Márgenes a 0 — space-between distribuye el espacio */
    .lq-eyebrow { margin-bottom: 0 !important; margin-top: 1.5cm; }
    .lq-col-left h1 { margin-bottom: 0 !important; margin-top: -1.5cm !important; font-size: 30px !important; line-height: 1.18 !important; }
    .lq-intro { font-size: 13.5px !important; line-height: 1.72 !important; margin-bottom: 0 !important; text-align: justify !important; padding-right: 6mm !important; position: relative !important; top: -7mm !important; }
    .lq-benefits { gap: 7px !important; margin-bottom: 0 !important; position: relative !important; top: -1.5cm !important; }
    .lq-inspire { font-size: 12px !important; margin-bottom: 0 !important; position: relative !important; top: -2cm !important; }
    /* Botón CTA: se traslada al slide 2 en mobile */
    .lq-section .lq-cta-inline { display: none !important; }

    .lq-scroll-arrow {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      padding: 12px 0 16px !important;
      flex-shrink: 0 !important;
      text-decoration: none !important;
      cursor: pointer !important;
    }

    /* Slide 2: acordeón — visible en mobile */
    #lq-slide-acordeon { display: block; }
  }
</style>

