    </a>
    <p style="font-size:13px;color:var(--el-gray);margin:0;">© 2026 Disciplina Imparable. Todos los derechos reservados.</p>
  </footer>

</div>

<script>
(function(){
  var h = document.getElementById('el-header');
  if (h) window.addEventListener('scroll', function(){ h.classList.toggle('scrolled', window.scrollY > 60); }, { passive: true });
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.el-anim').forEach(function(el){ obs.observe(el); });
})();
</script>

