<script>
(function(){
  var items = document.querySelectorAll('.lq-item');
  items.forEach(function(item){
    var trigger = item.querySelector('.lq-trigger');
    var body    = item.querySelector('.lq-body');
    var icon    = item.querySelector('.lq-icon');
    trigger.addEventListener('click', function(){
      var isOpen = item.classList.contains('lq-item--open');
      items.forEach(function(i){
        i.classList.remove('lq-item--open');
        i.querySelector('.lq-trigger').setAttribute('aria-expanded', 'false');
        i.querySelector('.lq-body').setAttribute('aria-hidden', 'true');
        i.querySelector('.lq-icon').textContent = '+';
      });
      if (!isOpen) {
        item.classList.add('lq-item--open');
        trigger.setAttribute('aria-expanded', 'true');
        body.setAttribute('aria-hidden', 'false');
        icon.textContent = '−';
      }
    });
  });
})();
</script>

