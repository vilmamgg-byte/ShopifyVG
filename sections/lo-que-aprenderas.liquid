  /* ── Viewport fijo: todo en una pantalla ── */
  .lq-section {
    height: 100vh;
    padding: 0 72px;
    background: var(--el-deep);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .lq-wrap {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 80px;
    padding-bottom: 58px;
    box-sizing: border-box;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .lq-layout {
    display: grid;
    grid-template-columns: 40fr 60fr;
    align-items: center;
    gap: 0;
    height: 100%;
  }

  .lq-col-left {
    padding-right: 56px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .lq-col-left::after {
    content: '';
    position: absolute;
    right: 0;
    top: 8%;
    bottom: 8%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(201,168,76,0.16) 25%,
      rgba(201,168,76,0.16) 75%,
      transparent
    );
  }

  .lq-col-right {
    padding-left: 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .lq-quote-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 13px;
    color: rgba(240,218,184,0.45);
    line-height: 1.65;
    border-left: 1px solid rgba(201,168,76,0.22);
    padding-left: 14px;
    margin-bottom: 22px;
  }

  .lq-accordion { width: 100%; }

  /* Footer pegado al fondo de la sección */
  .lq-footer-abs {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: transparent;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 0 min(8vw, 80px) 16px;
  }

  @media (max-width: 900px) {
    .lq-section { height: auto; padding: 80px 24px 70px; }
    .lq-wrap { padding-top: 0; padding-bottom: 0; height: auto; }
    .lq-layout { grid-template-columns: 1fr; height: auto; }
    .lq-col-left {
      padding-right: 0; padding-bottom: 32px;
      border-right: none; border-bottom: 1px solid rgba(201,168,76,0.14);
      height: auto;
    }
    .lq-col-right { padding-left: 0; height: auto; }
    .lq-footer-abs { position: static; border-top: 1px solid rgba(255,255,255,0.06); }
  }
  .lq-item {
    border-top: 1px solid rgba(201,168,76,0.14);
  }
  .lq-item:last-child {
    border-bottom: 1px solid rgba(201,168,76,0.14);
  }
  .lq-trigger {
    display: flex;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 22px 3px;
    cursor: pointer;
    gap: 24px;
    text-align: left;
  }
  .lq-trigger:focus-visible {
    outline: 1px solid rgba(201,168,76,0.4);
    outline-offset: 2px;
  }
  .lq-num {
    font-family: 'Manrope', sans-serif;
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.30em;
    color: rgba(212,175,55,0.72);
    min-width: 24px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }
  .lq-name {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(12px, 1.27vw, 15px);
    font-weight: 500;
    color: #ffffff;
    letter-spacing: 0.04em;
    flex: 1;
    transition: color 0.3s ease;
  }
  .lq-icon {
    font-size: 17px;
    font-weight: 200;
    color: rgba(201,168,76,0.60);
    line-height: 1;
    width: 19px;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    transition: color 0.3s ease, transform 0.3s ease;
    flex-shrink: 0;
  }
  .lq-item--open .lq-num { color: rgba(201,168,76,0.90); }
  .lq-item--open .lq-name { color: #c9a84c; }
  .lq-item--open .lq-icon { color: rgba(201,168,76,1); }
  .lq-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.32s cubic-bezier(0.4,0,0.2,1), opacity 0.28s ease;
    opacity: 0;
  }
  .lq-item--open .lq-body {
    max-height: 221px;
    opacity: 1;
  }
  .lq-list {
    list-style: none;
    padding: 0 3px 24px 48px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .lq-list li {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: rgba(228,215,190,0.68);
    line-height: 1.7;
    letter-spacing: 0.02em;
    padding-left: 15px;
    position: relative;
  }
  .lq-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 1px;
    background: rgba(201,168,76,0.50);
  }
  @media (max-width: 768px) {
    .lq-trigger { padding: 14px 3px; gap: 15px; }
    .lq-list { padding-left: 31px; }
  }
</style>

