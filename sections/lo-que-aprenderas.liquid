  <!-- Hero de página -->
  <section style="min-height:38vh;display:flex;align-items:center;background:var(--el-deep);padding:140px 48px 72px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 50% 0%,rgba(201,168,76,0.07) 0%,transparent 65%);pointer-events:none;"></div>
    <div class="el-container" style="position:relative;z-index:2;">
      <span class="el-label el-anim" style="margin-bottom:20px;display:inline-flex;">6 Módulos de Transformación</span>
      <h1 class="el-hero-title el-anim el-anim-d1" style="font-size:clamp(34px,4vw,58px);max-width:700px;margin-bottom:20px;">
        Seis módulos que<br>
        <span class="el-gold-text">redefinen quién eres</span>
      </h1>
