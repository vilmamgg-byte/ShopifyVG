{%- assign policy_handle = policy.url | remove: '/policies/' -%}
{%- if policy_handle == 'privacy-policy' -%}
  {%- assign pp_eyebrow = 'Política de Privacidad' -%}
  {%- assign pp_title = 'Privacidad y confianza' -%}
  {%- assign pp_subtitle = 'Información clara sobre cómo se recopilan, utilizan y protegen tus datos al utilizar Disciplina Imparable.' -%}
{%- elsif policy_handle == 'terms-of-service' -%}
  {%- assign pp_eyebrow = 'Términos de Servicio' -%}
  {%- assign pp_title = 'Condiciones de uso' -%}
  {%- assign pp_subtitle = 'Información esencial sobre el uso del sitio, la compra del método y el acceso al contenido digital.' -%}
{%- elsif policy_handle == 'refund-policy' -%}
  {%- assign pp_eyebrow = 'Política de Reembolsos' -%}
  {%- assign pp_title = 'Garantía y reembolsos' -%}
  {%- assign pp_subtitle = 'Conoce las condiciones de nuestra garantía de satisfacción y el proceso de reembolso.' -%}
{%- else -%}
  {%- assign pp_eyebrow = policy.title -%}
  {%- assign pp_title = policy.title -%}
  {%- assign pp_subtitle = '' -%}
{%- endif -%}

<style>
  #shopify-section-group-header-group,
  .shopify-section-group--header-group,
  sticky-header,
  .skip-to-content-link { display: none !important; }
  #shopify-section-group-footer-group,
  .shopify-section-group--footer-group,
  footer.footer { display: none !important; }
  body{background:#050505!important;color:rgba(255,255,255,.78)!important}
  #MainContent{margin:0!important;padding:0!important}
  .pp-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:10px;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;color:#c9a84c;background:rgba(201,168,76,.07);border:1px solid rgba(201,168,76,.22);padding:7px 20px;border-radius:100px;margin-bottom:28px}
  .pp-dot{width:5px;height:5px;background:#c9a84c;border-radius:50%;animation:ppDot 2.4s ease-in-out infinite}
  @keyframes ppDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(.6)}}
  .pp-subtitle{font-size:16px;color:#777;line-height:1.78;max-width:620px;margin:12px auto 0}
  .shopify-policy__container .shopify-policy__title{margin-top:38px}
</style>

<div class="shopify-policy__container policy--{{ policy_handle }}">
  <div class="shopify-policy__title">
    <div class="pp-eyebrow"><span class="pp-dot"></span>{{ pp_eyebrow }}</div>
    <h1>{{ pp_title }}</h1>
    {%- if pp_subtitle != blank -%}<p class="pp-subtitle">{{ pp_subtitle }}</p>{%- endif -%}
  </div>
  <div class="shopify-policy__body">
    {{ policy.body | replace: 'vilmamgg@gmail.com', 'contacto@disciplinaimparable.com' }}
  </div>
</div>
