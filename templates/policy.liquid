<div class="shopify-policy__container">
  <div class="shopify-policy__title">
    <div class="pp-eyebrow"><span class="pp-dot"></span>{{ pp_eyebrow }}</div>
    <h1>{{ pp_title }}</h1>
    {%- if pp_subtitle != blank -%}<p class="pp-subtitle">{{ pp_subtitle }}</p>{%- endif -%}
  </div>
  <div class="shopify-policy__body">
    {{ policy.body | replace: 'vilmamgg@gmail.com', 'contacto@disciplinaimparable.com' }}
  </div>
</div>

