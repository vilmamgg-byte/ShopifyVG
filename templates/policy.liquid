{%- layout 'none' -%}<!doctype html>
<html lang="es" style="background:#080808;color:#ffffff">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ policy.title | default: 'Políticas' }} | Disciplina Imparable</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  {{ 'ebook-landing.css' | asset_url | stylesheet_tag }}
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{background:#080808 !important}
    body{background:#080808 !important;color:#fff !important;font-family:'Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased}
    #MainContent{padding:0 !important;margin:0 !important}
    .pp-header{padding:120px 48px 64px;text-align:center;position:relative;border-bottom:1px solid rgba(201,168,76,.12);overflow:hidden;background:#080808}
    .pp-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 80% at 50% 0%,rgba(201,168,76,.06) 0%,transparent 70%);pointer-events:none}
    .pp-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:10px;font-weight:700;letter-spacing:3.5px;text-transform:uppercase;color:#c9a84c;background:rgba(201,168,76,.07);border:1px solid rgba(201,168,76,.22);padding:7px 20px;border-radius:100px;margin-bottom:28px;position:relative;z-index:1}
    .pp-dot{width:5px;height:5px;background:#c9a84c;border-radius:50%;animation:ppDot 2.4s ease-in-out infinite}
    @keyframes ppDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(.6)}}
    .pp-title{font-family:'Poppins',sans-serif;font-size:clamp(36px,5vw,64px);font-weight:800;letter-spacing:-2px;line-height:1.04;color:#fff;margin:0 0 18px;position:relative;z-index:1}
    .pp-subtitle{font-size:16px;color:#777;line-height:1.78;max-width:620px;margin:0 auto;position:relative;z-index:1}
    .pp-wrap{max-width:900px;margin:0 auto;padding:72px 48px 96px;background:#080808}
    .pp-body{color:#999;font-size:16px;line-height:1.85}
    .pp-body h1{font-family:'Poppins',sans-serif;font-size:clamp(20px,2.5vw,26px);font-weight:700;color:#fff;letter-spacing:-.4px;line-height:1.2;margin:52px 0 14px;padding-top:52px;border-top:1px solid rgba(255,255,255,.05)}
    .pp-body h1:first-child{margin-top:0;padding-top:0;border-top:none}
    .pp-body h2{font-family:'Poppins',sans-serif;font-size:clamp(17px,2vw,21px);font-weight:700;color:#e8c97a;letter-spacing:-.3px;line-height:1.25;margin:42px 0 12px;padding-top:42px;border-top:1px solid rgba(201,168,76,.09)}
    .pp-body h2:first-child{margin-top:0;padding-top:0;border-top:none}
    .pp-body h3{font-size:12px;font-weight:700;color:#c9a84c;letter-spacing:2px;text-transform:uppercase;margin:30px 0 10px}
    .pp-body h4{font-size:15px;font-weight:600;color:#ccc;margin:22px 0 8px}
    .pp-body p{font-size:16px;color:#999;line-height:1.85;margin:0 0 18px}
    .pp-body a{color:#c9a84c;text-decoration:none;border-bottom:1px solid rgba(201,168,76,.28);transition:color .2s,border-color .2s}
    .pp-body a:hover{color:#e8c97a;border-color:rgba(232,201,122,.55)}
    .pp-body ul,.pp-body ol{color:#999;font-size:16px;line-height:1.85;margin:0 0 20px;padding-left:22px}
    .pp-body li{margin-bottom:9px}
    .pp-body ul li::marker{color:#c9a84c}
    .pp-body ol li::marker{color:#c9a84c;font-weight:600}
    .pp-body strong,.pp-body b{color:#ddd;font-weight:600}
    .pp-body hr{border:none;border-top:1px solid rgba(201,168,76,.1);margin:44px 0}
    .pp-footer{border-top:1px solid rgba(255,255,255,.06);padding:44px 48px;text-align:center;background:#060606}
    .pp-footer-nav{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px 0;margin-bottom:16px;padding:0;list-style:none}
    .pp-footer-nav a{font-size:10.5px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:#555;text-decoration:none;padding:4px 12px;transition:color .2s}
    .pp-footer-nav a:hover,.pp-footer-nav a[aria-current="page"]{color:#c9a84c}
    .pp-footer-sep{color:rgba(201,168,76,.28);font-size:11px}
    .pp-footer-copy{font-size:12px;color:#3a3a3a;margin:0;letter-spacing:.5px}
    @media(max-width:768px){
      .pp-header{padding:96px 24px 48px}
      .pp-title{letter-spacing:-1.5px}
      .pp-wrap{padding:44px 24px 64px}
      .pp-body h1{font-size:19px;margin-top:38px;padding-top:38px}
      .pp-body h2{font-size:16px;margin-top:32px;padding-top:32px}
      .pp-footer{padding:32px 24px}
      .pp-footer-nav a{font-size:9.5px;padding:4px 8px}
    }
  </style>
</head>
<body style="background:#080808;color:#ffffff;margin:0;padding:0">

{%- assign policy_handle = policy.url | remove: '/policies/' -%}
{%- if policy_handle == 'privacy-policy' -%}
  {%- assign pp_eyebrow = 'Política de Privacidad' -%}
  {%- assign pp_title = 'Privacidad y confianza' -%}
  {%- assign pp_subtitle = 'Información clara sobre cómo se recopilan, utilizan y protegen tus datos al utilizar Disciplina Imparable.' -%}
{%- elsif policy_handle == 'terms-of-service' -%}
  {%- assign pp_eyebrow = 'Términos de Servicio' -%}
  {%- assign pp_title = 'Condiciones de uso' -%}
  {%- assign pp_subtitle = 'Información esencial sobre el uso del sitio, la compra del método y el acceso al contenido digital.' -%}
{%- elsif policy_handle == 'refund-policy' -%}
  {%- assign pp_eyebrow = 'Política de Reembolsos' -%}
  {%- assign pp_title = 'Garantía y reembolsos' -%}
  {%- assign pp_subtitle = 'Conoce las condiciones de nuestra garantía de satisfacción y el proceso de reembolso.' -%}
{%- else -%}
  {%- assign pp_eyebrow = policy.title -%}
  {%- assign pp_title = policy.title -%}
  {%- assign pp_subtitle = '' -%}
{%- endif -%}

<header class="el-header" id="el-header">
  <a href="/" class="el-logo">
    <div class="el-logo-mark">
      <svg width="30" height="30" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="lgH" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#c9a84c"/><stop offset="50%" stop-color="#f0d878"/><stop offset="100%" stop-color="#c9a84c"/></linearGradient>
          <linearGradient id="lgV" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#f5e090"/><stop offset="45%" stop-color="#c9a84c"/><stop offset="100%" stop-color="#8a6820"/></linearGradient>
          <linearGradient id="lL" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.20"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0.05"/></linearGradient>
          <linearGradient id="lR" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.11"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0.03"/></linearGradient>
          <radialGradient id="lA" cx="50%" cy="55%" r="50%"><stop offset="0%" stop-color="#c9a84c" stop-opacity="0.10"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0"/></radialGradient>
          <filter id="lgw"><feGaussianBlur stdDeviation="1.2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <ellipse cx="28" cy="33" rx="22" ry="19" fill="url(#lA)"/>
        <path d="M27 11 L7 15.5 L7 44 L27 39.5 Z" fill="url(#lL)" stroke="#c9a84c" stroke-width="1.05" stroke-linejoin="round"/>
        <path d="M29 11 L49 15.5 L49 44 L29 39.5 Z" fill="url(#lR)" stroke="#c9a84c" stroke-width="0.8" stroke-linejoin="round"/>
        <line x1="28" y1="11" x2="28" y2="39.5" stroke="url(#lgV)" stroke-width="2.8" stroke-linecap="round" filter="url(#lgw)"/>
        <path d="M28 4 L31 9.5 L28 12.5 L25 9.5 Z" fill="url(#lgV)"/>
        <path d="M28 5.5 L30 9.5 L28 11.5 L26 9.5 Z" fill="#f5e090" opacity="0.55"/>
        <line x1="11" y1="19.5" x2="25" y2="18" stroke="url(#lgH)" stroke-width="1.15" stroke-linecap="round" opacity="0.78"/>
        <line x1="11" y1="23.2" x2="25" y2="21.7" stroke="url(#lgH)" stroke-width="1.15" stroke-linecap="round" opacity="0.72"/>
        <line x1="31" y1="18" x2="45.5" y2="19.5" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.44"/>
        <line x1="31" y1="21.7" x2="45.5" y2="23.2" stroke="#c9a84c" stroke-width="1.05" stroke-linecap="round" opacity="0.38"/>
        <circle cx="7" cy="15.5" r="1.6" fill="#c9a84c" opacity="0.80" filter="url(#lgw)"/>
        <circle cx="28" cy="11" r="1.6" fill="#f5e090" opacity="0.65"/>
        <circle cx="28" cy="39.5" r="1.8" fill="#c9a84c" opacity="0.45"/>
      </svg>
    </div>
    <span class="el-logo-text">
      <span class="el-logo-d">DISCIPLINA</span><span class="el-logo-i">IMPARABLE</span>
    </span>
  </a>
  <nav class="el-nav" aria-label="Navegación principal">
    <a href="/">Inicio</a>
    <div class="el-dropdown" role="navigation">
      <button class="el-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
        Método Imparable
        <svg class="el-dropdown-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="el-dropdown-panel" role="menu">
        <a href="/pages/vision-general" class="el-dropdown-item" role="menuitem"><span class="el-dropdown-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></span><span><strong>Visión General</strong><small>Qué es y cómo funciona</small></span></a>
        <a href="/pages/lo-que-aprenderas" class="el-dropdown-item" role="menuitem"><span class="el-dropdown-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7l2-7z"/></svg></span><span><strong>Lo Que Aprenderás</strong><small>Contenido y resultados</small></span></a>
      </div>
    </div>
    <a href="/pages/beneficios">Beneficios</a>
    <a href="/pages/resultados">Resultados</a>
    <a href="/pages/testimonios">Testimonios</a>
    <a href="/pages/faq">FAQ</a>
    <a href="/pages/shopifyvg" class="el-nav-cta">Obtener ahora</a>
  </nav>
  <button class="el-mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="pp-header">
  <div class="pp-eyebrow"><span class="pp-dot"></span>{{ pp_eyebrow }}</div>
  <h1 class="pp-title">{{ pp_title }}</h1>
  {%- if pp_subtitle != blank -%}<p class="pp-subtitle">{{ pp_subtitle }}</p>{%- endif -%}
</div>

<div class="pp-wrap">
  <div class="pp-body">
    {{ policy.body | replace: 'vilmamgg@gmail.com', 'contacto@disciplinaimparable.com' }}
  </div>
</div>

<footer class="pp-footer">
  <nav class="pp-footer-nav">
    <a href="/#la-voz">Sobre la Autora</a>
    <span class="pp-footer-sep">·</span>
    <a href="https://www.instagram.com/" target="_blank" rel="noopener">Instagram</a>
    <span class="pp-footer-sep">·</span>
    <a href="/pages/contacto">Contacto</a>
    <span class="pp-footer-sep">·</span>
    <a href="/policies/privacy-policy"{% if policy_handle == 'privacy-policy' %} aria-current="page"{% endif %}>Privacidad</a>
    <span class="pp-footer-sep">·</span>
    <a href="/policies/terms-of-service"{% if policy_handle == 'terms-of-service' %} aria-current="page"{% endif %}>Términos</a>
  </nav>
  <p class="pp-footer-copy">© 2026 Disciplina Imparable</p>
</footer>

{{ 'ebook-landing.js' | asset_url | script_tag }}
</body>
</html>
