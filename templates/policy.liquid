{{ 'ebook-landing.css' | asset_url | stylesheet_tag }}

<style>
  /* Ocultar header y footer de Dawn SOLO en páginas de políticas */
  body.policy-page #shopify-section-group-header-group,
  body.policy-page #shopify-section-group-footer-group,
  body.policy-page .skip-to-content-link { display: none !important; }

  /* Reset del body y main */
  body.policy-page {
    background: #080808 !important;
    display: block !important;
    font-family: 'Inter', sans-serif !important;
    color: #ffffff !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  body.policy-page #MainContent {
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ── ENCABEZADO PREMIUM ── */
  .pp-header {
    padding: 120px 48px 64px;
    text-align: center;
    position: relative;
    border-bottom: 1px solid rgba(201,168,76,0.12);
    overflow: hidden;
    background: #080808;
  }

  .pp-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 80% at 50% 0%, rgba(201,168,76,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .pp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: #c9a84c;
    background: rgba(201,168,76,0.07);
    border: 1px solid rgba(201,168,76,0.22);
    padding: 7px 20px;
    border-radius: 100px;
    margin-bottom: 28px;
    position: relative;
    z-index: 1;
  }

  .pp-dot {
    width: 5px; height: 5px;
    background: #c9a84c;
    border-radius: 50%;
    animation: ppDot 2.4s ease-in-out infinite;
  }

  @keyframes ppDot {
    0%,100% { opacity:1; transform:scale(1); }
    50%      { opacity:.3; transform:scale(.6); }
  }

  .pp-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.04;
    color: #ffffff;
    margin: 0 0 18px;
    position: relative;
    z-index: 1;
  }

  .pp-subtitle {
    font-size: 16px;
    color: #777777;
    line-height: 1.78;
    max-width: 620px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* ── CONTENIDO ── */
  .pp-wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 72px 48px 96px;
    background: #080808;
  }

  .pp-body {
    color: #999999;
    font-size: 16px;
    line-height: 1.85;
    font-family: 'Inter', sans-serif;
  }

  .pp-body h1 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.4px;
    line-height: 1.2;
    margin: 52px 0 14px;
    padding-top: 52px;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .pp-body h1:first-child { margin-top: 0; padding-top: 0; border-top: none; }

  .pp-body h2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 700;
    color: #e8c97a;
    letter-spacing: -0.3px;
    line-height: 1.25;
    margin: 42px 0 12px;
    padding-top: 42px;
    border-top: 1px solid rgba(201,168,76,0.09);
  }

  .pp-body h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }

  .pp-body h3 {
    font-size: 12px;
    font-weight: 700;
    color: #c9a84c;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 30px 0 10px;
  }

  .pp-body h4 { font-size: 15px; font-weight: 600; color: #cccccc; margin: 22px 0 8px; }

  .pp-body p { font-size: 16px; color: #999999; line-height: 1.85; margin: 0 0 18px; }

  .pp-body a {
    color: #c9a84c;
    text-decoration: none;
    border-bottom: 1px solid rgba(201,168,76,0.28);
    transition: color .2s, border-color .2s;
  }

  .pp-body a:hover { color: #e8c97a; border-color: rgba(232,201,122,.55); }

  .pp-body ul, .pp-body ol {
    color: #999999; font-size: 16px; line-height: 1.85;
    margin: 0 0 20px; padding-left: 22px;
  }

  .pp-body li { margin-bottom: 9px; }
  .pp-body ul li::marker { color: #c9a84c; }
  .pp-body ol li::marker { color: #c9a84c; font-weight: 600; }
  .pp-body strong, .pp-body b { color: #dddddd; font-weight: 600; }
  .pp-body em, .pp-body i { color: #bbbbbb; }

  .pp-body table {
    width: 100%; border-collapse: collapse;
    margin: 26px 0; font-size: 14px;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px; overflow: hidden;
  }

  .pp-body th {
    background: rgba(201,168,76,0.07);
    color: #c9a84c; font-size: 11px; font-weight: 700;
    letter-spacing: 1.2px; text-transform: uppercase;
    padding: 12px 16px; text-align: left;
    border-bottom: 1px solid rgba(201,168,76,0.14);
  }

  .pp-body td {
    padding: 12px 16px; color: #999999;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    vertical-align: top;
  }

  .pp-body tr:last-child td { border-bottom: none; }
  .pp-body tr:nth-child(even) td { background: rgba(255,255,255,0.015); }
  .pp-body hr { border: none; border-top: 1px solid rgba(201,168,76,0.1); margin: 44px 0; }

  /* ── FOOTER ── */
  .pp-footer {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 44px 48px;
    text-align: center;
    background: #060606;
  }

  .pp-footer-nav {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: 4px 0;
    margin-bottom: 16px; padding: 0; list-style: none;
  }

  .pp-footer-nav a {
    font-family: 'Inter', sans-serif;
    font-size: 10.5px; font-weight: 700;
    letter-spacing: 1.8px; text-transform: uppercase;
    color: #555555; text-decoration: none;
    padding: 4px 12px; transition: color .2s;
  }

  .pp-footer-nav a:hover,
  .pp-footer-nav a[aria-current="page"] { color: #c9a84c; }

  .pp-footer-sep { color: rgba(201,168,76,0.28); font-size: 11px; }

  .pp-footer-copy {
    font-family: 'Inter', sans-serif;
    font-size: 12px; color: #3a3a3a;
    margin: 0; letter-spacing: 0.5px;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .pp-header { padding: 96px 24px 48px; }
    .pp-title { letter-spacing: -1.5px; }
    .pp-subtitle { font-size: 15px; }
    .pp-wrap { padding: 44px 24px 64px; }
    .pp-body h1 { font-size: 19px; margin-top: 38px; padding-top: 38px; }
    .pp-body h2 { font-size: 16px; margin-top: 32px; padding-top: 32px; }
    .pp-body p, .pp-body ul, .pp-body ol { font-size: 15px; }
    .pp-body th, .pp-body td { padding: 10px 12px; font-size: 13px; }
    .pp-footer { padding: 32px 24px; }
    .pp-footer-nav a { font-size: 9.5px; padding: 4px 8px; }
  }
</style>

{%- comment -%} Detectar cuál policy se está mostrando {%- endcomment -%}
{%- assign policy_handle = policy.url | remove: '/policies/' -%}

{%- if policy_handle == 'privacy-policy' -%}
  {%- assign pp_eyebrow  = 'Política de Privacidad' -%}
  {%- assign pp_title    = 'Privacidad y confianza' -%}
  {%- assign pp_subtitle = 'Información clara sobre cómo se recopilan, utilizan y protegen tus datos al utilizar Disciplina Imparable.' -%}
{%- elsif policy_handle == 'terms-of-service' -%}
  {%- assign pp_eyebrow  = 'Términos de Servicio' -%}
  {%- assign pp_title    = 'Condiciones de uso' -%}
  {%- assign pp_subtitle = 'Información esencial sobre el uso del sitio, la compra del método y el acceso al contenido digital.' -%}
{%- elsif policy_handle == 'refund-policy' -%}
  {%- assign pp_eyebrow  = 'Política de Reembolsos' -%}
  {%- assign pp_title    = 'Garantía y reembolsos' -%}
  {%- assign pp_subtitle = 'Conoce las condiciones de nuestra garantía de satisfacción y el proceso de reembolso.' -%}
{%- else -%}
  {%- assign pp_eyebrow  = policy.title -%}
  {%- assign pp_title    = policy.title -%}
  {%- assign pp_subtitle = '' -%}
{%- endif -%}

